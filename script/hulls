#!/usr/bin/env python3
"""script/hulls: sheets of the hulls the engine's first generator makes
(App/hulls.luau), taken off the screen.

  script/hulls seeds  [FROM [COUNT [SIZE]]] [PAINT] [CLASS] [STYLE]
        COUNT seeds from FROM on (40 from 1), each at SIZE (2)
  script/hulls broad  [FROM [COUNT [SIZE]]] [PAINT] [CLASS] [STYLE]
        the same, but only of the seeds whose hulls are broad (at least a
        third as wide as they are long): most of what the generator grows
        in its own style is long and thin
  script/hulls sizes  SEED [PAINT] [STYLE]     one seed at each of the eight sizes
  script/hulls paints SEED [SIZE] [STYLE]      one seed in every paint
  script/hulls styles SEED [SIZE] [PAINT] [CLASS]   one seed in every style

The numbers come first and in that order; the words after them, in any
order. The word "above" among them takes every picture from straight
over the hull, its bow to the right, in place of from the bow quarter
(what a hull's plan is, is seen from there).

SIZE is 1 to 8: how many plates the generator grows (3, 4, 5, 5, 6, 7, 8, 9)
and, from 4 up, with a broad deck under each. It made a frigate at 2 and
its biggest hulls at about 5.
PAINT is bare (as the engine made them; this if none is named), civil,
vessari, talmar, kethri, vail or unbound.
CLASS shows each hull as a ship, at that class's size: frigate,
destroyer, cruiser, battleship, attackbattlecruiser, battlecruiser,
capitalindustrial, siegedreadnought, carrier, dreadnought or
supercarrier (42, 75, 150, 400, 200, 300, 700, 950, 1000, 1300 and
1300 m in radius). It is given that class's guns and
engines where the game's rule of hardpoints lets them stand: on the
hull's own faces, or, where none is wide enough for a gun's whole foot,
on seats let into it. "no room" is written on a hull that has not the
room for them even so. (A bare hull stays bare: the generator's own
mesh and metal.)
STYLE is the set of the generator's own numbers the hull is grown with:
old (its own; this if none is named), stout, broad, tall, spear, slab,
soft, triangular, asymmetrical or triangular_v2 (Hull.STYLES in
resource/script/Game/View/Hull.luau). The word "asym" among the words
grows every hull of the sheet with its two sides unalike, whatever its
style.

The sheet is written to cache/hulls/ and its name printed. Every picture
has its seed (or size, paint or style) written on it.

To go through the seeds by hand, in a window:  bin/launch hulls
(Left and Right step the seed, [ and ] the size, S the style, A its sides
alike or not, P the paint, F shows it as a ship, K keeps one in
cache/hulls-kept.txt.)
"""
import os
import subprocess
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
os.chdir(ROOT)
PAINTS = ["bare", "civil", "vessari", "talmar", "kethri", "vail", "unbound"]
CLASSES = ["frigate", "destroyer", "cruiser", "battleship", "attackbattlecruiser", "battlecruiser", "capitalindustrial",
           "siegedreadnought", "carrier", "dreadnought", "supercarrier"]
STYLES = ["old", "stout", "broad", "tall", "spear", "slab", "soft", "triangular", "asymmetrical", "triangular_v2"]
ASYM = "+asym"
PLATES = [3, 4, 5, 5, 6, 7, 8, 9]
DECKS = [False, False, False, True, True, True, True, True]
FOLDER = os.path.join("cache", "hulls")
TAKEN = os.path.join(FOLDER, "shots")
SCRIPT = os.path.join(FOLDER, "sheet.txt")


def usage(why=None):
    if why:
        print(f"hulls: {why}\n", file=sys.stderr)
    print(__doc__, file=sys.stderr)
    sys.exit(2)


def describe(size):
    return f"size {size} ({PLATES[size - 1]} plates{', decks' if DECKS[size - 1] else ''})"


def launch(limit):
    """Run the browser off the screen on the script of commands; its output."""
    # (bin/launch takes a scripted run off the desktop by itself)
    env = dict(os.environ)
    env.setdefault("DRI_PRIME", "1")
    return subprocess.run(["bin/launch", "hulls", "--no-present", "--fixed-step", "60", "--scale", "2", "--timeout", str(limit),
                           "--out", TAKEN, "--script", SCRIPT], env=env, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)


def lua(word):
    return "nil" if word is None else f"'{word}'"


def main():
    args = sys.argv[1:]
    if not args or args[0] in ("-h", "--help", "help"):
        usage()
    kind, rest = args[0], args[1:]
    if kind not in ("seeds", "broad", "sizes", "paints", "styles"):
        usage(f"'{kind}' is not seeds, broad, sizes, paints or styles")
    numbers, colour, shown, style = [], None, None, None
    above = "above" in rest
    asym = "asym" in rest
    rest = [word for word in rest if word not in ("above", "asym")]
    for word in rest:
        if word.isdigit():
            if colour or shown or style:
                usage("the numbers come before the words")
            numbers.append(int(word))
        elif word in PAINTS:
            colour = word
        elif word in CLASSES:
            shown = word
        elif word in STYLES:
            style = word
        else:
            usage(f"'{word}' is not a number, a paint, a class or a style")

    def number(at, default, low, high, what):
        if len(numbers) <= at:
            if default is None:
                usage(f"{what} is wanted")
            return default
        if numbers[at] < low or numbers[at] > high:
            usage(f"{what} is from {low} to {high}")
        return numbers[at]

    # (with "asym", every hull is its style with its sides unalike: the style's name with "+asym" after it)
    def grown_as(each):
        return (each or "old") + ASYM if asym else each
    os.makedirs(TAKEN, exist_ok=True)
    how = (f", {style}" if style and kind != "styles" else "") + (", sides unalike" if asym else "") + (f", as a {shown}" if shown else "") + (", from above" if above else "")
    tag = (f"-{style}" if style and kind != "styles" else "") + ("-asym" if asym else "") + (f"-{shown}" if shown else "") + ("-above" if above else "")
    paint = colour or "bare"
    # (each picture: its seed, its size, its paint, its style, and what is written on it)
    if kind in ("seeds", "broad"):
        first = number(0, 1, 0, 10 ** 9, "the first seed")
        count = number(1, 40, 1, 400, "how many")
        size = number(2, 2, 1, 8, "the size")
        seeds = list(range(first, first + count))
        what = f"seeds {first} to {first + count - 1}"
        if kind == "broad":
            # (the browser says which they are: it has the generator)
            with open(SCRIPT, "w") as out:
                out.write(f"frames 2\nlua print('BROAD ' .. Hulls.Broad({first}, {count}, {size}, {lua(style)}))\nquit\n")
            found = [line for line in launch(60).stdout.splitlines() if line.startswith("BROAD")]
            if not found:
                print("hulls: the browser did not say which seeds are broad", file=sys.stderr)
                sys.exit(1)
            seeds = [int(seed) for seed in found[0][6:].split(",") if seed.strip()]
            if not seeds:
                print(f"hulls: no broad hull in the {40 * count} seeds from {first}", file=sys.stderr)
                sys.exit(1)
            what = f"the {len(seeds)} broad ones from seed {first} to {seeds[-1]}"
        shots = [(seed, size, paint, style, f"seed {seed}") for seed in seeds]
        title = f"The generator's hulls: {what}, {describe(size)}, {paint}{how}"
        name = f"{kind}-{seeds[0]}-{seeds[-1]}-size{size}-{paint}{tag}"
    elif kind == "sizes":
        seed = number(0, None, 0, 10 ** 9, "the seed")
        shots = [(seed, size, paint, style, describe(size)) for size in range(1, 9)]
        title = f"The generator's hulls: seed {seed} at every size, {paint}{how}"
        name = f"sizes-seed{seed}-{paint}{tag}"
    elif kind == "paints":
        seed = number(0, None, 0, 10 ** 9, "the seed")
        size = number(1, 2, 1, 8, "the size")
        shots = [(seed, size, each, style, each) for each in PAINTS]
        title = f"The generator's hulls: seed {seed}, {describe(size)}, in every paint{how}"
        name = f"paints-seed{seed}-size{size}{tag}"
    else:
        seed = number(0, None, 0, 10 ** 9, "the seed")
        size = number(1, 2, 1, 8, "the size")
        shots = [(seed, size, paint, each, each) for each in STYLES]
        title = f"The generator's hulls: seed {seed}, {describe(size)}, {paint}, in every style{how}"
        name = f"styles-seed{seed}-size{size}-{paint}{tag}"

    lines = ["frames 10"]
    files = []
    for index, (seed, size, each, grown, _) in enumerate(shots):
        file = f"{name}-{index:04d}"
        files.append(os.path.join(TAKEN, file + ".png"))
        if os.path.exists(files[-1]):
            os.remove(files[-1])
        lines += [f"lua assert(Hulls.Show({seed}, {size}, '{each}', {lua(shown)}, {lua(grown_as(grown))}))"]
        if above:
            # (a quarter of the way round, so that the bow is to the right, and as nearly over it as the browser looks)
            lines += ["lua Hulls.Look(0.25, 0.238, 2.6)"]
        if shown:
            lines += [f"lua print('FIT', {index}, Hulls.Fitted())"]
        lines += ["frames 6", f"shot {file}", "frames 2"]
    lines += ["echo hulls sheet taken", "quit"]
    with open(SCRIPT, "w") as out:
        out.write("\n".join(lines) + "\n")
    run = launch(60 + 4 * len(shots))
    missing = [file for file in files if not os.path.exists(file)]
    if run.returncode != 0 or missing or "hulls sheet taken" not in run.stdout:
        tail = "\n".join(line for line in run.stdout.splitlines() if "[Warning]" not in line)[-2000:]
        print(f"hulls: the run failed (exit {run.returncode}, {len(missing)} of {len(files)} pictures missing)\n{tail}", file=sys.stderr)
        sys.exit(1)

    # (which of them had no room for their class's hardpoints)
    cramped = set()
    for line in run.stdout.splitlines():
        fields = line.split("\t")
        if fields[0] == "FIT" and len(fields) >= 4 and fields[3] != "true":
            cramped.add(int(fields[1]))
    if shown:
        print(f"{len(shots) - len(cramped)} of {len(shots)} have room for a {shown}'s hardpoints")

    from PIL import Image, ImageDraw, ImageFont
    try:
        big = ImageFont.truetype("/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf", 24)
        small = ImageFont.truetype("/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf", 20)
    except OSError:
        big = small = ImageFont.load_default()
    columns = 4 if len(shots) <= 8 else 5
    wide, high, bar = 480, 270, 44
    rows = (len(shots) + columns - 1) // columns
    sheet = Image.new("RGB", (columns * wide, bar + rows * high), (12, 14, 18))
    draw = ImageDraw.Draw(sheet)
    draw.text((12, 9), title, fill=(235, 235, 235), font=big)
    for index, (file, shot) in enumerate(zip(files, shots)):
        x, y = (index % columns) * wide, bar + (index // columns) * high
        sheet.paste(Image.open(file).convert("RGB").resize((wide, high), Image.LANCZOS), (x, y))
        draw.text((x + 10, y + 8), shot[4], fill=(255, 255, 255), font=small, stroke_width=2, stroke_fill=(0, 0, 0))
        if index in cramped:
            draw.text((x + 10, y + 34), "no room", fill=(255, 170, 90), font=small, stroke_width=2, stroke_fill=(0, 0, 0))
    out = os.path.join(FOLDER, f"sheet-{name}.png")
    sheet.save(out)
    print(os.path.join(ROOT, out))


main()
