#!/usr/bin/env bash
# script/simsweep: run the universe simulation over several seeds at once
# and judge every run against the thresholds in Tool/SimProbe.
#
#   script/simsweep [--seeds N] [--ticks N] [--systems N] [--jobs N] [--out DIR]
#
# Defaults: 8 seeds (galaxy seed = history seed = 1..N), 40000 ticks
# (about 4.6 game days), 400 systems, one job per CPU, output under
# cache/sim/sweep-<time>/. Each seed gets a directory with series.csv
# (the time series), news.txt and result.txt. The scorecard printed at
# the end (and saved as scorecard.txt) has a row per check and a column
# per seed. Exits 1 if any check failed on any seed.

set -u
cd "$(dirname "$0")/.."

seeds=8
ticks=40000
systems=400
jobs=$(nproc)
out="cache/sim/sweep-$(date +%Y%m%d-%H%M%S)"
while [ $# -gt 0 ]; do
  case "$1" in
    --seeds) seeds=$2 ;;
    --ticks) ticks=$2 ;;
    --systems) systems=$2 ;;
    --jobs) jobs=$2 ;;
    --out) out=$2 ;;
    *) echo "usage: script/simsweep [--seeds N] [--ticks N] [--systems N] [--jobs N] [--out DIR]"; exit 2 ;;
  esac
  shift 2
done

if [ ! -x bin/ltcore ]; then
  echo "script/simsweep: bin/ltcore is missing; run python3 configure.py build"
  exit 2
fi
mkdir -p "$out"

echo "simsweep: $seeds seeds, $ticks ticks, $systems systems, $jobs at a time -> $out"
start=$SECONDS
seq 1 "$seeds" | xargs -P "$jobs" -I{} sh -c \
  "bin/ltcore Tool/simrun --galaxy {} --history {} --ticks $ticks --systems $systems --out '$out/seed-{}' > '$out/seed-{}.log' 2>&1"
echo "simsweep: runs finished in $((SECONDS - start)) s"

# The scorecard: one row per check, one column per seed, then how many
# seeds passed it.
awk -F'[=|]' -v seeds="$seeds" '
  FNR == 1 { seed++ }
  $1 == "check" {
    if (!($2 in order)) { order[$2] = ++n; name[n] = $2; limit[n] = $4 }
    value[order[$2], seed] = $3
    status[order[$2], seed] = $5
    if ($5 == "ok") passed[order[$2]]++; else failed++
  }
  END {
    printf "%-36s", "check"
    for (s = 1; s <= seeds; s++) printf " %9s", "seed " s
    printf "  %s\n", "passed"
    for (i = 1; i <= n; i++) {
      printf "%-36s", name[i]
      for (s = 1; s <= seeds; s++)
        printf " %8.3f%s", value[i, s], (status[i, s] == "ok" ? " " : "!")
      printf "  %d/%d  (%s)\n", passed[i] + 0, seeds, limit[i]
    }
    printf "\n%s\n", (failed > 0 ? failed " check(s) failed (marked !)" : "all checks passed")
    exit (failed > 0 ? 1 : 0)
  }
' $(for s in $(seq 1 "$seeds"); do echo "$out/seed-$s/result.txt"; done) | tee "$out/scorecard.txt"
exit "${PIPESTATUS[0]}"
