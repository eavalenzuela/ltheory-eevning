#!/usr/bin/env python3
"""script/modelgen: hull models written as Wavefront OBJ, from numbers.

    script/modelgen            write every model to resource/model
    script/modelgen DIR        write them under DIR instead

A hull here is a handful of skins, each drawn through cross-sections set
along the ship's length (a hull, a needle, a rail, an engine pod). A
section is a rounded shape (a superellipse: from a diamond through an
oval to nearly a box) with its own width, its height above and below its
middle, and where its middle is. Every face is given one of the game's
six paints by where it is: plating, patch, frame, lit, trim, fire.

The file is as Blender writes and reads one by default: Y up, the ship
pointing along -Z, a unit long, with one object to a part and one
material to a paint. Nothing here needs Blender; Blender opens what this
writes (File, Import, Wavefront), and the game reads it as it is
(Game/View/Imported).

The models are the Vail's hulls, from the project owner's drawings
(docs/concepts/vail).
"""
import math
import os
import sys

PAINTS = ["plating", "patch", "frame", "lit", "trim", "fire"]
# What each paint looks like in Blender (the game has its own paints).
MTL = {
    "plating": ((0.46, 0.32, 0.18), (0, 0, 0)),
    "patch": ((0.16, 0.15, 0.14), (0, 0, 0)),
    "frame": ((0.10, 0.10, 0.10), (0, 0, 0)),
    "lit": ((1.0, 0.70, 0.25), (1.0, 0.62, 0.18)),
    "trim": ((0.06, 0.06, 0.06), (0, 0, 0)),
    "fire": ((1.0, 0.55, 0.15), (1.0, 0.50, 0.12)),
}


def curve(keys):
    """A smooth line through (t, value) keys that never overshoots them."""
    keys = sorted(keys)
    ts = [k[0] for k in keys]
    vs = [k[1] for k in keys]
    n = len(keys)
    slopes = [(vs[i + 1] - vs[i]) / (ts[i + 1] - ts[i]) for i in range(n - 1)]
    tangents = [slopes[0]]
    for i in range(1, n - 1):
        a, b = slopes[i - 1], slopes[i]
        tangents.append(0.0 if a * b <= 0 else 2 * a * b / (a + b))
    tangents.append(slopes[-1])

    def at(t):
        if t <= ts[0]:
            return vs[0]
        if t >= ts[-1]:
            return vs[-1]
        i = max(j for j in range(n - 1) if ts[j] <= t)
        h = ts[i + 1] - ts[i]
        s = (t - ts[i]) / h
        return ((2 * s ** 3 - 3 * s ** 2 + 1) * vs[i] + (s ** 3 - 2 * s ** 2 + s) * h * tangents[i]
                + (-2 * s ** 3 + 3 * s ** 2) * vs[i + 1] + (s ** 3 - s ** 2) * h * tangents[i + 1])
    return at


def const(value):
    return lambda t: value


class Model:
    def __init__(self):
        self.vertices = []      # (x, y, z): x to starboard, y up, z forward
        self.objects = []       # (name, [(paint, (a, b, c)), ...])

    def vertex(self, p):
        self.vertices.append(p)
        return len(self.vertices) - 1

    def skin(self, name, t0, t1, rings, around, shape, paint, caps=("trim", "trim"), lean=None):
        """A skin from t0 to t1 along the ship (0 its prow, 1 its stern).

        'shape(t)' gives (x, y, half width, height above, height below,
        roundness above, roundness below) of the section at t; 'paint(u,
        t, angle, x, y)' the paint of a face (angle 0 to starboard, a
        quarter turn up). 'caps' paints the two ends, or None for an end
        left open (one that comes to a point needs none).

        'rings' is how many rows of faces there are; or, with 'lean', the
        length of a row. 'lean(u, x)' is how far aft of its row's own
        place u a point of the row lies: with it the rows are not rings
        square across the ship but run where the lean says, so that paint
        laid on by rows (u, a row's own place) has clean edges that are
        not square across it either: chevrons.
        """
        def point(t, j):
            cx, cy, a, top, bottom, n_top, n_bottom = shape(t)
            angle = 2 * math.pi * j / around
            c, s = math.cos(angle), math.sin(angle)
            n = n_top if s >= 0 else n_bottom
            return (cx + a * math.copysign(abs(c) ** (2 / n), c),
                    cy + (top if s >= 0 else bottom) * math.copysign(abs(s) ** (2 / n), s), 0.5 - t)

        if lean is None:
            rows = [t0 + (t1 - t0) * i / rings for i in range(rings + 1)]
        else:
            # (how far the lean goes either way, anywhere on the skin)
            leans = [lean(t0 + (t1 - t0) * i / 60, point(t0 + (t1 - t0) * i / 60, j)[0]) for i in range(-12, 73) for j in range(around)]
            first, last = t0 - max(leans), t1 - min(leans)
            step = rings
            rows = [first] + [k * step for k in range(math.ceil(first / step + 1e-6), math.floor(last / step - 1e-6) + 1)] + [last]
        faces = []
        loops = []
        for u in rows:
            loop = []
            for j in range(around):
                t = min(max(u, t0), t1)
                if lean is not None:
                    for _ in range(12):
                        t = min(max(u + lean(u, point(t, j)[0]), t0), t1)
                loop.append((t, self.vertex(point(t, j))))
            loops.append((u, loop))
        for i in range(len(rows) - 1):
            ua, la = loops[i]
            ub, lb = loops[i + 1]
            for j in range(around):
                k = (j + 1) % around
                corners = (la[j], la[k], lb[j], lb[k])
                # (rows that have run into an end of the skin lie on one another there)
                if abs(la[j][0] - lb[j][0]) < 1e-9 and abs(la[k][0] - lb[k][0]) < 1e-9:
                    continue
                angle = 2 * math.pi * (j + 0.5) / around
                mid = [sum(self.vertices[v][axis] for _, v in corners) / 4 for axis in range(3)]
                what = paint((ua + ub) / 2, sum(t for t, _ in corners) / 4, angle, mid[0], mid[1])
                # (wound so that, with z turned about for the file, it is
                # counter-clockwise seen from outside)
                faces.append((what, (la[j][1], la[k][1], lb[k][1])))
                faces.append((what, (la[j][1], lb[k][1], lb[j][1])))
        for end, cap in ((0, caps[0]), (len(rows) - 1, caps[1])):
            if cap is None:
                continue
            t = t0 if end == 0 else t1
            loop = loops[end][1]
            cx, cy = shape(t)[0], shape(t)[1]
            hub = self.vertex((cx, cy, 0.5 - t))
            for j in range(around):
                k = (j + 1) % around
                faces.append((cap, (hub, loop[k][1], loop[j][1]) if end == 0 else (hub, loop[j][1], loop[k][1])))
        self.objects.append((name, faces))

    def write(self, path, title):
        base = os.path.splitext(os.path.basename(path))[0]
        with open(os.path.splitext(path)[0] + ".mtl", "w") as out:
            out.write(f"# {title}: the paints of its faces, as the game names them.\n")
            for name in PAINTS:
                (r, g, b), (er, eg, eb) = MTL[name]
                out.write(f"\nnewmtl {name}\nKd {r:.3f} {g:.3f} {b:.3f}\nKe {er:.3f} {eg:.3f} {eb:.3f}\nNs 60\nd 1\nillum 2\n")
        triangles = 0
        with open(path, "w") as out:
            out.write(f"# {title}\n# Y up, the prow along -Z, a unit long. Made by script/modelgen.\n")
            out.write(f"mtllib {base}.mtl\n")
            for x, y, z in self.vertices:
                # (the game's z runs forward; a file's -Z does)
                out.write(f"v {x:.5f} {y:.5f} {-z:.5f}\n")
            for name, faces in self.objects:
                out.write(f"o {name}\ns 1\n")
                current = None
                for paint, (a, b, c) in sorted(faces, key=lambda face: PAINTS.index(face[0])):
                    if paint != current:
                        out.write(f"usemtl {paint}\n")
                        current = paint
                    # (wound counter-clockwise seen from outside, as a file's faces are)
                    out.write(f"f {a + 1} {b + 1} {c + 1}\n")
                    triangles += 1
        return triangles


class Camo:
    """Broad bands across the hull, swept back from its middle line in
    chevrons, their edges a little uneven: plating and patch by turns.
    A skin whose rows lean as 'lean' says, a 'step' apart, has the edges
    of the bands along its rows."""

    def __init__(self, period, sweep, shift=0.0, rows=8):
        self.period, self.sweep, self.shift = period, sweep, shift
        self.step = period / 2 / rows

    def lean(self, u, x):
        # (uneven by where across the ship it is and by which band it is:
        # never by how far along, or a row could double back on itself)
        wobble = 0.014 * math.sin(41 * x + 19 * u) + 0.009 * math.sin(83 * abs(x) - 27 * u + 2) + 0.006 * math.sin(150 * x + 11 * u)
        return self.sweep * abs(x) + wobble

    def paint(self, u):
        band = (u + self.shift) / self.period
        return "plating" if band - math.floor(band) < 0.5 else "patch"


def vail_frigate():
    """The first of the Vail concepts: a sleek teardrop of a hull behind a
    needle prow, with a rail down each flank that sweeps aft to an engine
    pod held off the tail."""
    model = Model()
    camo = Camo(0.17, 0.75, 0.0)
    width = curve([(0.085, 0.020), (0.16, 0.034), (0.25, 0.070), (0.35, 0.108), (0.45, 0.135), (0.52, 0.143), (0.60, 0.136),
                   (0.68, 0.108), (0.74, 0.078), (0.83, 0.045), (0.94, 0.032)])
    above = curve([(0.085, 0.020), (0.16, 0.034), (0.25, 0.058), (0.35, 0.080), (0.50, 0.092), (0.65, 0.080), (0.80, 0.050),
                   (0.94, 0.028)])
    below = curve([(0.085, 0.020), (0.16, 0.030), (0.30, 0.052), (0.50, 0.066), (0.70, 0.054), (0.94, 0.024)])
    peak = curve([(0.085, 2.0), (0.20, 1.9), (0.35, 1.6), (0.75, 1.6), (0.94, 2.0)])

    # Dark hatches let into the back, by where their middles are and how big.
    hatches = [(0.30, 0.0, 0.020, 0.010), (0.42, 0.036, 0.016, 0.010), (0.42, -0.036, 0.016, 0.010), (0.56, 0.0, 0.020, 0.009),
               (0.68, 0.036, 0.016, 0.010), (0.68, -0.036, 0.016, 0.010)]

    def hull_paint(u, t, angle, x, y):
        if math.sin(angle) > 0.5:
            for ht, hx, long, wide in hatches:
                if abs(t - ht) < long and abs(x - hx) < wide:
                    return "trim"
        return camo.paint(u)

    model.skin("hull", 0.085, 0.94, camo.step, 48,
               lambda t: (0.0, 0.0, width(t), above(t), below(t), peak(t), 2.2), hull_paint, ("trim", "trim"), camo.lean)

    # The needle, and the collar it stands in.
    model.skin("needle", 0.0, 0.070, 10, 16,
               lambda t: (0.0, 0.0, 0.0005 + 0.0125 * t / 0.070, 0.0005 + 0.0125 * t / 0.070, 0.0005 + 0.0125 * t / 0.070, 2.0, 2.0),
               lambda u, t, angle, x, y: "patch" if t < 0.030 else "plating", (None, "trim"))
    model.skin("collar", 0.066, 0.090, 3, 20, lambda t: (0.0, 0.0, 0.0225, 0.0225, 0.0225, 2.0, 2.0),
               lambda u, t, angle, x, y: "trim", ("trim", "trim"))

    def slit(name, t0, t1, where):
        """A lit slit: a thin strip standing just proud of what it is on."""
        model.skin(name, t0, t1, 4, 6, lambda t: where(t) + (0.0022, 0.0030, 0.0030, 4.0, 4.0),
                   lambda u, t, angle, x, y: "lit", ("lit", "lit"))

    for side, name in ((1, "starboard"), (-1, "port")):
        # Lit slits on the flanks of the neck.
        slit(f"light.neck.{name}", 0.100, 0.138, lambda t, side=side: (side * (width(t) + 0.0005), 0.004))

        # A rail along the flank: on the hull's edge as far as its widest,
        # then leaving it for the engine pod.
        out = curve([(0.30, 0.092), (0.36, 0.114), (0.44, 0.138), (0.52, 0.148), (0.60, 0.144), (0.68, 0.127), (0.74, 0.106),
                     (0.78, 0.087), (0.81, 0.074)])
        girth = curve([(0.30, 0.25), (0.37, 1.0), (0.74, 1.0), (0.81, 0.85)])

        def rail(t, side=side, out=out, girth=girth):
            g = girth(t)
            return (side * out(t), 0.008, 0.013 * g, 0.024 * g, 0.020 * g, 4.0, 4.0)

        model.skin(f"rail.{name}", 0.30, 0.81, camo.step, 12, rail, lambda u, t, angle, x, y: camo.paint(u), ("patch", None),
                   camo.lean)
        # (a broken line of lit slits along its outer face)
        for n in range(7):
            t0 = 0.40 + 0.052 * n
            slit(f"light.rail.{name}.{n + 1}", t0, t0 + 0.034, lambda t, side=side, out=out: (side * (out(t) + 0.0128), 0.010))

        # The engine pod: pointed before, square in the body; and its nozzle.
        pod_wide = curve([(0.770, 0.004), (0.80, 0.020), (0.835, 0.030), (0.92, 0.030), (0.955, 0.025)])
        pod_high = curve([(0.770, 0.004), (0.80, 0.022), (0.835, 0.033), (0.92, 0.033), (0.955, 0.027)])

        def pod(t, side=side, pod_wide=pod_wide, pod_high=pod_high):
            return (side * 0.068, 0.006, pod_wide(t), pod_high(t), pod_high(t) * 0.9, 4.5, 4.5)

        model.skin(f"pod.{name}", 0.770, 0.955, camo.step, 16, pod, lambda u, t, angle, x, y: camo.paint(u), ("patch", "trim"),
                   camo.lean)
        slit(f"light.pod.{name}", 0.845, 0.925, lambda t, side=side: (side * (0.068 + 0.0300), 0.008))
        model.skin(f"nozzle.{name}", 0.945, 1.0, 4, 18,
                   lambda t, side=side: (side * 0.068, 0.006, 0.0215 - 0.04 * (t - 0.945), 0.0215 - 0.04 * (t - 0.945),
                                         0.0215 - 0.04 * (t - 0.945), 2.0, 2.0),
                   lambda u, t, angle, x, y: "trim", ("trim", "fire"))
    return model, "The Vail's frigate: the first of the owner's drawings (a frigate, until it is said otherwise)"


MODELS = {"vail/frigate": vail_frigate}


def main():
    root = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
    out = sys.argv[1] if len(sys.argv) > 1 else os.path.join(root, "resource", "model")
    for name, build in MODELS.items():
        model, title = build()
        path = os.path.join(out, name + ".obj")
        os.makedirs(os.path.dirname(path), exist_ok=True)
        triangles = model.write(path, title)
        print(f"{os.path.relpath(path)}: {len(model.vertices)} points, {triangles} faces, {len(model.objects)} parts")


main()
