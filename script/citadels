#!/usr/bin/env python3
"""script/citadels: sheets of the citadels Game/View/Citadel grows, taken
off the screen through the viewer (App/viewer, Viewer.Citadel).
  script/citadels SIZE [FROM [COUNT]] [DETAIL...] [PAINT] [STYLE] [asym] [cel1|cel2]
        COUNT seeds (20) from FROM (1) on, at SIZE (1 small to 5 huge);
        with "asym", grown asymmetrical; STYLE is blocks (if none),
        pyramid, diamond or wormhole (Citadel.STYLES)
DETAIL is any of antennas, pipes, greebles, lights and rivets, or "all"
for every one (Game/View/Hull's surface detail). PAINT is a paint of
Hull.looks (civil if none). The sheet is written to cache/citadels/ and
its name printed; every picture has its seed written on it. What a size
is drawn as in the game is the seed picked for it in Citadel.Pick.
"""
import os
import subprocess
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
os.chdir(ROOT)
DETAILS = ["antennas", "pipes", "greebles", "lights", "rivets"]
PAINTS = ["civil", "bare", "vessari", "talmar", "kethri", "vail", "unbound", "orun"]
STYLES = ["blocks", "pyramid", "diamond", "wormhole"]
SIZES = ["small", "medium", "large", "extra-large", "huge"]
FOLDER = os.path.join("cache", "citadels")
TAKEN = os.path.join(FOLDER, "shots")
SCRIPT = os.path.join(FOLDER, "sheet.txt")


def usage(why=None):
    if why:
        print(f"citadels: {why}", file=sys.stderr)
    print(__doc__.strip(), file=sys.stderr)
    sys.exit(2)


def main():
    args = sys.argv[1:]
    if not args or args[0] in ("-h", "--help", "help"):
        usage()
    numbers = [int(word) for word in args if word.isdigit()]
    words = [word for word in args if not word.isdigit()]
    details = DETAILS if "all" in words else [word for word in DETAILS if word in words]
    paint = next((word for word in words if word in PAINTS), None)
    look = "cel2" if "cel2" in words else "cel1" if "cel1" in words else None
    asym = "asym" in words
    style = next((word for word in words if word in STYLES), None)
    for word in words:
        if word not in DETAILS and word not in PAINTS and word not in STYLES and word not in ("all", "cel1", "cel2", "asym"):
            usage(f"'{word}' is not a detail, a paint or a look")
    if not numbers or not 1 <= numbers[0] <= 5:
        usage("SIZE is 1 to 5")
    size = numbers[0]
    first = numbers[1] if len(numbers) > 1 else 1
    count = numbers[2] if len(numbers) > 2 else 20
    os.makedirs(TAKEN, exist_ok=True)
    tag = f"size{size}-{first}-{first + count - 1}" + ("-" + "-".join(details) if details else "") + (f"-{paint}" if paint else "") + (f"-{look}" if look else "") + ("-asym" if asym else "") + (f"-{style}" if style else "")
    lines = ["frames 10"]
    if look:
        lines += ["lua RenderPass_SetEnabled('Smooth Shading', false)", f"lua RenderPass_SetEnabled('Flat Paint', {'true' if look == 'cel2' else 'false'})"]
    files = []
    detail = " ".join(details)
    for seed in range(first, first + count):
        file = f"{tag}-{seed:06d}"
        files.append(os.path.join(TAKEN, file + ".png"))
        if os.path.exists(files[-1]):
            os.remove(files[-1])
        painted = f"'{paint}'" if paint else "nil"
        styled = f"'{style}'" if style else "nil"
        lines += [f"lua assert(Viewer.Citadel({seed}, {size}, {painted}, '{detail}', {'true' if asym else 'false'}, {styled}))", "frames 12", f"shot {file}", "frames 2"]
    lines += ["echo citadels sheet taken", "quit"]
    with open(SCRIPT, "w") as out:
        out.write("\n".join(lines) + "\n")
    env = dict(os.environ, DRI_PRIME=os.environ.get("DRI_PRIME", "1"))
    run = subprocess.run(["bin/launch", "viewer", "--no-present", "--fixed-step", "60", "--timeout", str(60 + 6 * count),
                          "--out", TAKEN, "--script", SCRIPT], env=env, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
    missing = [file for file in files if not os.path.exists(file)]
    if run.returncode != 0 or missing or "citadels sheet taken" not in run.stdout:
        tail = "\n".join(line for line in run.stdout.splitlines() if "[Warning]" not in line)[-2000:]
        print(f"citadels: the run failed (exit {run.returncode}, {len(missing)} of {len(files)} pictures missing)\n{tail}", file=sys.stderr)
        sys.exit(1)
    from PIL import Image, ImageDraw, ImageFont
    try:
        big = ImageFont.truetype("/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf", 24)
        small = ImageFont.truetype("/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf", 20)
    except OSError:
        big = small = ImageFont.load_default()
    columns = 5
    wide, high, bar = 480, 270, 44
    rows = (len(files) + columns - 1) // columns
    sheet = Image.new("RGB", (columns * wide, bar + rows * high), (12, 14, 18))
    draw = ImageDraw.Draw(sheet)
    title = f"Citadels, {SIZES[size - 1]} (size {size}): seeds {first} to {first + count - 1}" + (f", detail: {detail}" if detail else ", no detail") + (f", {paint}" if paint else "") + (f", {look}" if look else "") + (", asymmetrical" if asym else "") + (f", {style}" if style else "")
    draw.text((12, 9), title, fill=(235, 235, 235), font=big)
    for index, file in enumerate(files):
        x, y = (index % columns) * wide, bar + (index // columns) * high
        sheet.paste(Image.open(file).convert("RGB").resize((wide, high), Image.LANCZOS), (x, y))
        draw.text((x + 10, y + 8), f"seed {first + index}", fill=(255, 255, 255), font=small, stroke_width=2, stroke_fill=(0, 0, 0))
    out = os.path.join(FOLDER, f"sheet-{tag}.png")
    sheet.save(out)
    print(os.path.join(ROOT, out))


main()
