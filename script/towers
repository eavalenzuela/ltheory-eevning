#!/usr/bin/env python3
"""script/towers: sheets of the towers the generator grows for the
stations (App/towers.luau), taken off the screen.

  script/towers seeds  [FROM [COUNT [SIZE]]] [STYLE] [PAINT] [eight] [masts N]
        COUNT seeds from FROM on (40 from 1), each at SIZE (4)
  script/towers styles SEED [SIZE] [PAINT] [eight] [masts N]
        one seed in every style
  script/towers sizes  SEED [STYLE] [PAINT] [eight] [masts N]
        one seed at each of the eight sizes

The numbers come first and in that order; the words after them, in any
order.

SIZE is 1 to 8: one plate more than that is grown (2 to 9). The game's
small, middling and large towers are sizes 2, 4 and 6.
STYLE is blocky (this if none is named), cloud, spar, poured, stout,
needle, bulb or fins (Hull.TOWER_STYLES in
resource/script/Game/View/Hull.luau).
PAINT is vessari (this if none is named), talmar, orun, kethri, nimia,
vail or civil.
"eight" has every plate eight times about the tower's upright, where it
is otherwise four; "masts N" stands N masts (0 to 6) out of its top.

The sheet is written to cache/towers/ and its name printed. Every
picture has its seed (or style, or size) written on it.

To go through the seeds by hand, in a window:  bin/launch towers
(Left and Right step the seed, S the style, [ and ] the size, Q four
sides or eight, M the masts, P the paint, K keeps one in
cache/towers-kept.txt.)
"""
import os
import subprocess
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
os.chdir(ROOT)
STYLES = ["blocky", "cloud", "spar", "poured", "stout", "needle", "bulb", "fins"]
PAINTS = ["vessari", "talmar", "orun", "kethri", "nimia", "vail", "civil"]
PLATES = [2, 3, 4, 5, 6, 7, 8, 9]
FOLDER = os.path.join("cache", "towers")
TAKEN = os.path.join(FOLDER, "shots")
SCRIPT = os.path.join(FOLDER, "sheet.txt")


def usage(why=None):
    if why:
        print(f"towers: {why}\n", file=sys.stderr)
    print(__doc__, file=sys.stderr)
    sys.exit(2)


def describe(size):
    return f"size {size} ({PLATES[size - 1]} plates)"


def launch(limit):
    """Run the browser off the screen on the script of commands; its output."""
    # (bin/launch takes a scripted run off the desktop by itself)
    env = dict(os.environ)
    env.setdefault("DRI_PRIME", "1")
    return subprocess.run(["bin/launch", "towers", "--no-present", "--fixed-step", "60", "--timeout", str(limit),
                           "--out", TAKEN, "--script", SCRIPT], env=env, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)


def main():
    args = sys.argv[1:]
    if not args or args[0] in ("-h", "--help", "help"):
        usage()
    kind, rest = args[0], args[1:]
    if kind not in ("seeds", "styles", "sizes"):
        usage(f"'{kind}' is not seeds, styles or sizes")
    numbers, style, paint, eight, masts = [], None, None, False, 0
    words = False
    at = 0
    while at < len(rest):
        word = rest[at]
        if word == "masts":
            if at + 1 >= len(rest) or not rest[at + 1].isdigit() or int(rest[at + 1]) > 6:
                usage("masts wants a number from 0 to 6 after it")
            masts = int(rest[at + 1])
            words = True
            at += 1
        elif word.isdigit():
            if words:
                usage("the numbers come before the words")
            numbers.append(int(word))
        elif word in STYLES:
            style, words = word, True
        elif word in PAINTS:
            paint, words = word, True
        elif word == "eight":
            eight, words = True, True
        else:
            usage(f"'{word}' is not a number, a style, a paint, 'eight' or 'masts N'")
        at += 1

    def number(at, default, low, high, what):
        if len(numbers) <= at:
            if default is None:
                usage(f"{what} is wanted")
            return default
        if numbers[at] < low or numbers[at] > high:
            usage(f"{what} is from {low} to {high}")
        return numbers[at]

    os.makedirs(TAKEN, exist_ok=True)
    colour = paint or "vessari"
    grown = style or "blocky"
    how = (", eight sides" if eight else "") + (f", {masts} masts" if masts else "")
    tag = ("-eight" if eight else "") + (f"-masts{masts}" if masts else "")
    # (each picture: its seed, its size, its style, and what is written on it)
    if kind == "seeds":
        first = number(0, 1, 0, 10 ** 9, "the first seed")
        count = number(1, 40, 1, 400, "how many")
        size = number(2, 4, 1, 8, "the size")
        shots = [(seed, size, grown, f"seed {seed}") for seed in range(first, first + count)]
        title = f"Towers: seeds {first} to {first + count - 1}, {describe(size)}, {grown}, {colour}{how}"
        name = f"seeds-{first}-{first + count - 1}-size{size}-{grown}-{colour}{tag}"
    elif kind == "styles":
        seed = number(0, None, 0, 10 ** 9, "the seed")
        size = number(1, 4, 1, 8, "the size")
        shots = [(seed, size, each, each) for each in STYLES]
        title = f"Towers: seed {seed}, {describe(size)}, {colour}, in every style{how}"
        name = f"styles-seed{seed}-size{size}-{colour}{tag}"
    else:
        seed = number(0, None, 0, 10 ** 9, "the seed")
        shots = [(seed, size, grown, describe(size)) for size in range(1, 9)]
        title = f"Towers: seed {seed} at every size, {grown}, {colour}{how}"
        name = f"sizes-seed{seed}-{grown}-{colour}{tag}"

    lines = ["frames 10"]
    files = []
    for index, (seed, size, each, _) in enumerate(shots):
        file = f"{name}-{index:04d}"
        files.append(os.path.join(TAKEN, file + ".png"))
        if os.path.exists(files[-1]):
            os.remove(files[-1])
        lines += [f"lua assert(Towers.Show({seed}, {size}, '{each}', {'true' if eight else 'false'}, {masts}, '{colour}'))",
                  "frames 6", f"shot {file}", "frames 2"]
    lines += ["echo towers sheet taken", "quit"]
    with open(SCRIPT, "w") as out:
        out.write("\n".join(lines) + "\n")
    run = launch(60 + 4 * len(shots))
    missing = [file for file in files if not os.path.exists(file)]
    if run.returncode != 0 or missing or "towers sheet taken" not in run.stdout:
        tail = "\n".join(line for line in run.stdout.splitlines() if "[Warning]" not in line)[-2000:]
        print(f"towers: the run failed (exit {run.returncode}, {len(missing)} of {len(files)} pictures missing)\n{tail}", file=sys.stderr)
        sys.exit(1)

    from PIL import Image, ImageDraw, ImageFont
    try:
        big = ImageFont.truetype("/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf", 24)
        small = ImageFont.truetype("/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf", 18)
    except OSError:
        big = small = ImageFont.load_default()
    # (a tower stands in the middle of its picture: the middle of it is kept, upright)
    columns = 8
    wide, high, bar = 300, 420, 44
    rows = (len(shots) + columns - 1) // columns
    sheet = Image.new("RGB", (columns * wide, bar + rows * high), (12, 14, 18))
    draw = ImageDraw.Draw(sheet)
    draw.text((12, 9), title, fill=(235, 235, 235), font=big)
    for index, (file, shot) in enumerate(zip(files, shots)):
        x, y = (index % columns) * wide, bar + (index // columns) * high
        taken = Image.open(file).convert("RGB")
        across = int(taken.height * wide / high)
        left = (taken.width - across) // 2
        sheet.paste(taken.crop((left, 0, left + across, taken.height)).resize((wide, high), Image.LANCZOS), (x, y))
        draw.text((x + 8, y + 6), shot[3], fill=(255, 255, 255), font=small, stroke_width=2, stroke_fill=(0, 0, 0))
    out = os.path.join(FOLDER, f"sheet-{name}.png")
    sheet.save(out)
    print(os.path.join(ROOT, out))


main()
