#!/usr/bin/env python3
"""script/towers: sheets of the towers the generator makes for the
stations (App/towers.luau), taken off the screen.

  script/towers seeds   [FROM [COUNT [SIZE]]] [words]
        COUNT seeds from FROM on (40 from 1), each at SIZE (4)
  script/towers styles  SEED [SIZE] [words]
        one seed in every build
  script/towers sizes   SEED [words]
        one seed at each of the eight sizes
  script/towers manners SEED [SIZE] [words]
        one seed in each manner: the same tower, made otherwise
  script/towers folds   SEED [SIZE] [words]
        one seed as it is, and with each fold said over it
  script/towers weights SEED [SIZE] [words]
        one seed as it is, and with its weight in each place

The numbers come first and in that order; the words after them, in any
order:

  a build     pylon, parasol, gantry, ring, stack or mixed (mixed if none
              is named): a tower built in sections, the shape it cuts;
              or toroidal or spherical, a tower about a torus or a sphere
              (Tower.BUILDS in resource/script/Game/View/Tower.luau)
  manner M    blocky (if none is named), cloud, spar or poured: how what
              it is made of is made
  fold N      2, 3, 4, 6 or 8: how many times a thing is there about its
              upright, over what its seed says
  weight W    low, high, middle, ends or beads: where its weight is, over
              what its seed says
  a paint     vessari (if none is named), talmar, orun, kethri, nimia,
              vail or civil (one with no look of its own yet is shown
              in the Vessari's)

SIZE is 1 to 8: how much there is of the tower.

The sheet is written to cache/towers/ and its name printed. Every
picture has what it is written on it.

To go through the seeds by hand, in a window:  bin/launch towers
(Left and Right step the seed, S the style, [ and ] the size, N the
manner, F the fold, W the weight, P the paint, K keeps one in
cache/towers-kept.txt.)
"""
import os
import subprocess
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
os.chdir(ROOT)
BUILDS = ["pylon", "parasol", "gantry", "ring", "stack", "mixed", "toroidal", "spherical"]
MANNERS = ["blocky", "cloud", "spar", "poured"]
FOLDS = [2, 3, 4, 6, 8]
WEIGHTS = ["low", "high", "middle", "ends", "beads"]
PAINTS = ["vessari", "talmar", "orun", "kethri", "nimia", "vail", "civil"]
KINDS = ("seeds", "styles", "sizes", "manners", "folds", "weights")
FOLDER = os.path.join("cache", "towers")
TAKEN = os.path.join(FOLDER, "shots")
SCRIPT = os.path.join(FOLDER, "sheet.txt")


def usage(why=None):
    if why:
        print(f"towers: {why}\n", file=sys.stderr)
    print(__doc__, file=sys.stderr)
    sys.exit(2)


def launch(limit):
    """Run the browser off the screen on the script of commands; its output."""
    # (bin/launch takes a scripted run off the desktop by itself)
    env = dict(os.environ)
    env.setdefault("DRI_PRIME", "1")
    return subprocess.run(["bin/launch", "towers", "--no-present", "--fixed-step", "60", "--timeout", str(limit),
                           "--out", TAKEN, "--script", SCRIPT], env=env, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)


def main():
    args = sys.argv[1:]
    if not args or args[0] in ("-h", "--help", "help"):
        usage()
    kind, rest = args[0], args[1:]
    if kind not in KINDS:
        usage(f"'{kind}' is not one of: {', '.join(KINDS)}")
    numbers = []
    # (what every picture is of, unless the sheet's kind says otherwise for one)
    tower = {"style": "mixed", "manner": "blocky", "fold": 0, "weight": ""}
    paint = None
    words = False
    at = 0

    def after(word, among, what):
        if at + 1 >= len(rest) or rest[at + 1] not in among:
            usage(f"{word} wants {what} after it")
        return rest[at + 1]

    while at < len(rest):
        word = rest[at]
        if word == "fold":
            tower["fold"] = int(after(word, [str(n) for n in FOLDS], "2, 3, 4, 6 or 8"))
            words, at = True, at + 1
        elif word == "weight":
            tower["weight"] = after(word, WEIGHTS, "one of " + ", ".join(WEIGHTS))
            words, at = True, at + 1
        elif word == "manner":
            tower["manner"] = after(word, MANNERS, "one of " + ", ".join(MANNERS))
            words, at = True, at + 1
        elif word.isdigit():
            if words:
                usage("the numbers come before the words")
            numbers.append(int(word))
        elif word in BUILDS:
            tower["style"], words = word, True
        elif word in PAINTS:
            paint, words = word, True
        else:
            usage(f"'{word}' is not a number, a build, a paint, or one of: manner M, fold N, weight W")
        at += 1

    def number(at, default, low, high, what):
        if len(numbers) <= at:
            if default is None:
                usage(f"{what} is wanted")
            return default
        if numbers[at] < low or numbers[at] > high:
            usage(f"{what} is from {low} to {high}")
        return numbers[at]

    os.makedirs(TAKEN, exist_ok=True)
    colour = paint or "vessari"

    def described(shown):
        """What a tower is, in words: for a sheet's heading."""
        return (f"{shown['style']}, {shown['manner']}" + (f", fold {shown['fold']}" if shown["fold"] else "")
                + (f", weight {shown['weight']}" if shown["weight"] else ""))

    def tagged(shown):
        """The same, for a file's name."""
        return (f"{shown['style']}-{shown['manner']}" + (f"-fold{shown['fold']}" if shown["fold"] else "")
                + (f"-{shown['weight']}" if shown["weight"] else ""))

    # (each picture: its seed, its size, what it is of, and what is written on it)
    shots = []
    if kind == "seeds":
        first = number(0, 1, 0, 10 ** 9, "the first seed")
        count = number(1, 40, 1, 400, "how many")
        size = number(2, 4, 1, 8, "the size")
        shots = [(seed, size, tower, f"seed {seed}") for seed in range(first, first + count)]
        title = f"Towers: seeds {first} to {first + count - 1}, size {size}, {described(tower)}, {colour}"
        name = f"seeds-{first}-{first + count - 1}-size{size}-{tagged(tower)}-{colour}"
    elif kind == "sizes":
        seed = number(0, None, 0, 10 ** 9, "the seed")
        shots = [(seed, size, tower, f"size {size}") for size in range(1, 9)]
        title = f"Towers: seed {seed} at every size, {described(tower)}, {colour}"
        name = f"sizes-seed{seed}-{tagged(tower)}-{colour}"
    else:
        seed = number(0, None, 0, 10 ** 9, "the seed")
        size = number(1, 4, 1, 8, "the size")
        if kind == "styles":
            each = [(dict(tower, style=style), style) for style in BUILDS]
            over = f"in every build, {tower['manner']}"
        elif kind == "manners":
            each = [(dict(tower, manner=manner), manner) for manner in MANNERS]
            over = f"{tower['style']}, in every manner"
        elif kind == "folds":
            each = [(dict(tower, fold=0), "as the seed says")] + [(dict(tower, fold=fold), f"fold {fold}") for fold in FOLDS]
            over = f"{tower['style']}, {tower['manner']}, at every fold"
        else:
            each = [(dict(tower, weight=""), "as the seed says")] + [(dict(tower, weight=weight), weight) for weight in WEIGHTS]
            over = f"{tower['style']}, {tower['manner']}, its weight in every place"
        shots = [(seed, size, shown, label) for shown, label in each]
        title = f"Towers: seed {seed}, size {size}, {over}, {colour}"
        name = f"{kind}-seed{seed}-size{size}-{tagged(tower)}-{colour}"

    lines = ["frames 10"]
    files = []
    for index, (seed, size, shown, _) in enumerate(shots):
        file = f"{name}-{index:04d}"
        files.append(os.path.join(TAKEN, file + ".png"))
        if os.path.exists(files[-1]):
            os.remove(files[-1])
        lines += [f"lua assert(Towers.Show({seed}, {size}, '{shown['style']}', '{colour}', '{shown['manner']}', {shown['fold']}, "
                  f"'{shown['weight']}'))"]
        if shown["style"] == "toroidal":
            # (a wheel lying flat is looked at from higher up, or it is seen edge on)
            lines += ["lua Towers.Look(0.105, 0.085, 2.1)"]
        lines += ["frames 6", f"shot {file}", "frames 2"]
    lines += ["echo towers sheet taken", "quit"]
    with open(SCRIPT, "w") as out:
        out.write("\n".join(lines) + "\n")
    run = launch(60 + 4 * len(shots))
    missing = [file for file in files if not os.path.exists(file)]
    if run.returncode != 0 or missing or "towers sheet taken" not in run.stdout:
        tail = "\n".join(line for line in run.stdout.splitlines() if "[Warning]" not in line)[-2000:]
        print(f"towers: the run failed (exit {run.returncode}, {len(missing)} of {len(files)} pictures missing)\n{tail}", file=sys.stderr)
        sys.exit(1)

    from PIL import Image, ImageDraw, ImageFont
    try:
        big = ImageFont.truetype("/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf", 24)
        small = ImageFont.truetype("/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf", 18)
    except OSError:
        big = small = ImageFont.load_default()
    # (a tower stands in the middle of its picture: the middle of it is kept, upright;
    # or as broad as it is high, for a tower about a torus or a sphere, which is as wide as it is tall)
    broad = any(shot[2]["style"] in ("toroidal", "spherical") for shot in shots)
    columns = min(4 if broad else 8, len(shots))
    wide, high, bar = (600 if broad else 300), 420, 44
    rows = (len(shots) + columns - 1) // columns
    sheet = Image.new("RGB", (max(columns * wide, 1200), bar + rows * high), (12, 14, 18))
    draw = ImageDraw.Draw(sheet)
    draw.text((12, 9), title, fill=(235, 235, 235), font=big)
    for index, (file, shot) in enumerate(zip(files, shots)):
        x, y = (index % columns) * wide, bar + (index // columns) * high
        taken = Image.open(file).convert("RGB")
        across = int(taken.height * wide / high)
        left = (taken.width - across) // 2
        sheet.paste(taken.crop((left, 0, left + across, taken.height)).resize((wide, high), Image.LANCZOS), (x, y))
        draw.text((x + 8, y + 6), shot[3], fill=(255, 255, 255), font=small, stroke_width=2, stroke_fill=(0, 0, 0))
    out = os.path.join(FOLDER, f"sheet-{name}.png")
    sheet.save(out)
    print(os.path.join(ROOT, out))


main()
