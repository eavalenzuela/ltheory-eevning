#!/usr/bin/env bash
# script/check: one command that says whether the tree is healthy.
#
#   script/check            run everything except the soak
#   script/check --fast     skip the steps that open a window
#   script/check --soak     also run the soaks (about 25 minutes)
#
# Steps:
#   types       bin/luaucheck: every script, strict mode
#   boundary    an engine call planted in an engine-free directory must be
#               rejected by the type checker
#   specs       bin/ltcore Tool/specs: the engine-free test suites
#   specs-fail  a planted failing suite must make the runner exit non-zero
#   launch-*    bin/launch must exit 0 for a clean app, 1 for a script
#               error, and with 128 + the signal for a crash or a failed
#               assertion
#   game-flight the game app flies the M1 loop (test/scenario/flight.txt):
#               undock, warp, orbit, jump, dock, and a save taken in mid-warp
#               that must play out to the same state when loaded
#   game-combat the game app plays the M2 loop (test/scenario/combat.txt):
#               fit a module, fight the pirate at a belt, loot its wreck,
#               lose the ship and get home in the capsule
#   game-economy  the game app plays the M3 loop through its station screens
#               (test/scenario/economy.txt): mine, refine, build ammunition,
#               sell it by standing order, buy a hull, train for it, board it
#   game-arms   a hull of our own design carries its fitted weapons on its
#               hardpoints, and its turret comes to bear (test/scenario/arms.txt)
#   game-starbase  a pilot puts up a starbase through the game's screens
#               (test/scenario/starbase.txt): buy a tower, fuel and an array,
#               anchor the tower at a moon, moor, fuel it, anchor the array,
#               refine there
#   game-colony  a pilot works a planet through the game's screens
#               (test/scenario/colony.txt): buy a command centre, put it
#               down, raise an extractor and a processor, take goods up
#   game-lawless  a Courier goes out through low security into lawless space
#               (test/scenario/lawless.txt): the packs that come to a belt
#               there, in the pirates' own hulls, and the rare ores
#   game-menu   the menus and save slots (test/scenario/menu.txt): a new
#               game from a seed, saved, loaded and deleted through the
#               menus, and the assets window
#   game-galaxy  a galaxy of forty systems (test/scenario/galaxy.txt): the
#               star map, a destination, and the autopilot flying there
#   game-traffic  the other ships about (test/scenario/traffic.txt): haulers
#               and patrols at a homeworld, and a pilot marked for firing
#               on one
#   game-missions  the jobs a station offers (test/scenario/missions.txt):
#               taken, one filled and paid, one given up
#   game-sites  sites on nobody's chart (test/scenario/sites.txt): two
#               hidden belts found with the scanner, and a warp to one
#   game-tackle  holding another ship (test/scenario/tackle.txt): a
#               webifier and a warp disruptor fitted and used on a pirate
#   game-salvage  salvaging (test/scenario/salvage.txt): a salvager fitted,
#               a wreck stripped, and then looted
#   game-rigs   rigs (test/scenario/rigs.txt): one built of salvage, fitted,
#               and destroyed by taking it out
#   game-drones  drones (test/scenario/drones.txt): one launched, fighting
#               beside its ship, and called back
#   game-fleet  a hired pilot (test/scenario/fleet.txt): hired, given a ship,
#               out to a belt with the player, a pirate destroyed, a jump
#   game-miner  a hired pilot set to mine (test/scenario/miner.txt): a hold of
#               ore brought in to the station while the player sits docked
#   game-keys   flying by the keyboard (test/scenario/keys.txt): stop, warp,
#               pick out a pirate, lock, fire and web it, dock, by keys alone
#   game-pace   the game app must draw at least thirty frames a second just
#               outside the home station (test/scenario/pace.txt)
#   goldens     script/goldens: screenshots of the stored scenes must match
#               their images
#   goldens-fail  two made-up images that differ must be reported as differing
#   soak-N      (--soak) the 400-system strategic simulation, run in
#               memory and run with a save and load every 97 ticks, must
#               not differ over 40,000 ticks (four and a half game days,
#               wars included), for each of eight seeds in
#               parallel
#   econ-sweep  (--soak) script/econsweep: the galaxy's economy, with
#               fixed borders, must pass every threshold on 16 seeds over
#               30 game days
#   faction-sweep  (--soak) script/factionsweep: the powers, their wars
#               and the pirates on that economy must pass every threshold
#               on 32 seeds over 30 game days
#
# The planted failures matter as much as the real checks: they prove that
# a failure cannot be reported as success. Exits 0 only if every step did
# what it should. Build first (python3 configure.py build).

set -u
cd "$(dirname "$0")/.."

fast=0
soak=0
for arg in "$@"; do
  case "$arg" in
    --fast) fast=1 ;;
    --soak) soak=1 ;;
    *) echo "usage: script/check [--fast] [--soak]"; exit 2 ;;
  esac
done

# The discrete GPU, where this machine has one; harmless elsewhere.
: "${DRI_PRIME:=1}"
export DRI_PRIME

log=$(mktemp -d)
planted=resource/script/Tool/_planted_engine_call.luau
trap 'rm -rf "$log" "$planted"' EXIT

failures=0
summary=""

# step NAME EXPECTED-STATUS COMMAND...
step() {
  local name=$1 expected=$2
  shift 2
  local start=$SECONDS
  "$@" >"$log/$name.log" 2>&1
  local status=$?
  local took=$((SECONDS - start))
  if [ "$status" -eq "$expected" ]; then
    summary+=$(printf '  ok    %-13s %3ds\n' "$name" "$took")$'\n'
  else
    failures=$((failures + 1))
    summary+=$(printf '  FAIL  %-13s %3ds  exit %d, expected %d\n' "$name" "$took" "$status" "$expected")$'\n'
    echo "---- $name: exit $status, expected $expected ----"
    tail -n 40 "$log/$name.log"
    echo
  fi
}

for tool in bin/luaucheck bin/ltcore bin/launch; do
  if [ ! -x "$tool" ]; then
    echo "script/check: $tool is missing; run python3 configure.py build"
    exit 2
  fi
done

step types 0 bin/luaucheck

cat >"$planted" <<'LUAU'
--!strict
-- Written by script/check and deleted afterwards: engine-free code may not
-- call the engine, so this must fail the type check.
return Object_Universe(1, 0)
LUAU
step boundary 1 bin/luaucheck --no-generate "$planted"
rm -f "$planted"

step specs 0 bin/ltcore Tool/specs
step specs-fail 1 bin/ltcore Tool/specs --file Tool/selftest/failing.planted

if [ "$fast" -eq 0 ]; then
  step launch-pass 0 timeout 120 bin/launch selftest/pass
  step launch-error 1 timeout 120 bin/launch selftest/error
  step launch-segv 139 timeout 120 bin/launch selftest/pass --selftest segv
  step launch-assert 134 timeout 120 bin/launch selftest/pass --selftest assert
  step game-flight 0 timeout 600 bin/launch game --no-present --fixed-step 60 --timeout 500 \
    --script test/scenario/flight.txt
  step game-combat 0 timeout 600 bin/launch game --no-present --fixed-step 60 --timeout 500 \
    --script test/scenario/combat.txt
  step game-economy 0 timeout 600 bin/launch game --no-present --fixed-step 60 --timeout 500 \
    --script test/scenario/economy.txt
  step game-arms 0 timeout 400 bin/launch game --no-present --fixed-step 60 --timeout 300 \
    --script test/scenario/arms.txt
  step game-starbase 0 timeout 400 bin/launch game --no-present --fixed-step 60 --timeout 300 \
    --script test/scenario/starbase.txt
  step game-colony 0 timeout 400 bin/launch game --no-present --fixed-step 60 --timeout 300 \
    --script test/scenario/colony.txt
  step game-lawless 0 timeout 500 bin/launch game --no-present --fixed-step 60 --timeout 400 \
    --script test/scenario/lawless.txt
  step game-menu 0 timeout 400 bin/launch game --no-present --fixed-step 60 --timeout 300 \
    --script test/scenario/menu.txt
  step game-galaxy 0 timeout 700 bin/launch game --no-present --fixed-step 60 --timeout 600 \
    --script test/scenario/galaxy.txt
  step game-traffic 0 timeout 700 bin/launch game --no-present --fixed-step 60 --timeout 600 \
    --script test/scenario/traffic.txt
  step game-missions 0 timeout 400 bin/launch game --no-present --fixed-step 60 --timeout 300 \
    --script test/scenario/missions.txt
  step game-sites 0 timeout 400 bin/launch game --no-present --fixed-step 60 --timeout 300 \
    --script test/scenario/sites.txt
  step game-tackle 0 timeout 500 bin/launch game --no-present --fixed-step 60 --timeout 400 \
    --script test/scenario/tackle.txt
  step game-salvage 0 timeout 500 bin/launch game --no-present --fixed-step 60 --timeout 400 \
    --script test/scenario/salvage.txt
  step game-rigs 0 timeout 500 bin/launch game --no-present --fixed-step 60 --timeout 400 \
    --script test/scenario/rigs.txt
  step game-drones 0 timeout 600 bin/launch game --no-present --fixed-step 60 --timeout 500 \
    --script test/scenario/drones.txt
  step game-fleet 0 timeout 700 bin/launch game --no-present --fixed-step 60 --timeout 600 \
    --script test/scenario/fleet.txt
  step game-miner 0 timeout 700 bin/launch game --no-present --fixed-step 60 --timeout 600 \
    --script test/scenario/miner.txt
  step game-keys 0 timeout 500 bin/launch game --no-present --fixed-step 60 --timeout 400 \
    --script test/scenario/keys.txt
  step game-pace 0 timeout 200 bin/launch game --no-present --fixed-step 60 --timeout 150 \
    --script test/scenario/pace.txt
  step goldens 0 script/goldens
fi
step goldens-fail 1 script/goldens --planted

if [ "$soak" -eq 1 ]; then
  # Eight histories at once. (In the prototype one seed in five diverged:
  # fleet losses depended on the order a map gave its keys.)
  seeds="1 2 3 4 5 6 7 8"
  start=$SECONDS
  for seed in $seeds; do
    bin/ltcore Tool/simdiverge --galaxy "$seed" --history "$seed" --ticks 40000 >"$log/soak-$seed.log" 2>&1 &
  done
  wait
  took=$((SECONDS - start))
  for seed in $seeds; do
    if grep -q "^simdiverge: no difference" "$log/soak-$seed.log"; then
      summary+=$(printf '  ok    %-13s %3ds\n' "soak-$seed" "$took")$'\n'
    else
      failures=$((failures + 1))
      summary+=$(printf '  FAIL  %-13s %3ds  the reloaded run differs\n' "soak-$seed" "$took")$'\n'
      echo "---- soak-$seed ----"
      tail -n 45 "$log/soak-$seed.log"
      echo
    fi
  done
  # The galaxy's economy, judged on 16 seeds over 30 game days; then the
  # powers on top of it, on 32.
  step econ-sweep 0 script/econsweep --out "$log/econ"
  step faction-sweep 0 script/factionsweep --out "$log/faction"
fi

printf '%s' "$summary"
if [ "$failures" -gt 0 ]; then
  echo "check: $failures step(s) failed"
  exit 1
fi
echo "check: all steps passed$([ "$fast" -eq 1 ] && echo ' (window steps skipped)')"
