#!/usr/bin/env bash
# script/check: one command that says whether the tree is healthy.
#
#   script/check            run everything except the soak
#   script/check --fast     skip the steps that open a window
#   script/check --soak     also run the determinism soak (about 2 minutes)
#
# Steps:
#   types       bin/luaucheck: every script, strict mode
#   boundary    an engine call planted in an engine-free directory must be
#               rejected by the type checker
#   specs       bin/ltcore Tool/specs: the engine-free test suites
#   specs-fail  a planted failing suite must make the runner exit non-zero
#   launch-*    bin/launch must exit 0 for a clean app, 1 for a script
#               error, and with 128 + the signal for a crash or a failed
#               assertion
#   game-flight the game app flies the M1 loop (test/scenario/flight.txt):
#               undock, warp, orbit, jump, dock, and a save taken in mid-warp
#               that must play out to the same state when loaded
#   game-combat the game app plays the M2 loop (test/scenario/combat.txt):
#               fit a module, fight the pirate at a belt, loot its wreck,
#               lose the ship and get home in the capsule
#   goldens     script/goldens: screenshots of the stored scenes must match
#               their images
#   goldens-fail  two made-up images that differ must be reported as differing
#   soak-N      (--soak) the 400-system simulation, run in memory and run
#               with a save and load every 97 ticks, must not differ over
#               6000 ticks, for each of eight seeds in parallel
#
# The planted failures matter as much as the real checks: they prove that
# a failure cannot be reported as success. Exits 0 only if every step did
# what it should. Build first (python3 configure.py build).

set -u
cd "$(dirname "$0")/.."

fast=0
soak=0
for arg in "$@"; do
  case "$arg" in
    --fast) fast=1 ;;
    --soak) soak=1 ;;
    *) echo "usage: script/check [--fast] [--soak]"; exit 2 ;;
  esac
done

# The discrete GPU, where this machine has one; harmless elsewhere.
: "${DRI_PRIME:=1}"
export DRI_PRIME

log=$(mktemp -d)
planted=resource/script/Tool/_planted_engine_call.luau
trap 'rm -rf "$log" "$planted"' EXIT

failures=0
summary=""

# step NAME EXPECTED-STATUS COMMAND...
step() {
  local name=$1 expected=$2
  shift 2
  local start=$SECONDS
  "$@" >"$log/$name.log" 2>&1
  local status=$?
  local took=$((SECONDS - start))
  if [ "$status" -eq "$expected" ]; then
    summary+=$(printf '  ok    %-13s %3ds\n' "$name" "$took")$'\n'
  else
    failures=$((failures + 1))
    summary+=$(printf '  FAIL  %-13s %3ds  exit %d, expected %d\n' "$name" "$took" "$status" "$expected")$'\n'
    echo "---- $name: exit $status, expected $expected ----"
    tail -n 40 "$log/$name.log"
    echo
  fi
}

for tool in bin/luaucheck bin/ltcore bin/launch; do
  if [ ! -x "$tool" ]; then
    echo "script/check: $tool is missing; run python3 configure.py build"
    exit 2
  fi
done

step types 0 bin/luaucheck

cat >"$planted" <<'LUAU'
--!strict
-- Written by script/check and deleted afterwards: engine-free code may not
-- call the engine, so this must fail the type check.
return Object_Universe(1, 0)
LUAU
step boundary 1 bin/luaucheck --no-generate "$planted"
rm -f "$planted"

step specs 0 bin/ltcore Tool/specs
step specs-fail 1 bin/ltcore Tool/specs --file Tool/selftest/failing.planted

if [ "$fast" -eq 0 ]; then
  step launch-pass 0 timeout 120 bin/launch selftest/pass
  step launch-error 1 timeout 120 bin/launch selftest/error
  step launch-segv 139 timeout 120 bin/launch selftest/pass --selftest segv
  step launch-assert 134 timeout 120 bin/launch selftest/pass --selftest assert
  step game-flight 0 timeout 600 bin/launch game --no-present --fixed-step 60 --timeout 500 \
    --script test/scenario/flight.txt
  step game-combat 0 timeout 600 bin/launch game --no-present --fixed-step 60 --timeout 500 \
    --script test/scenario/combat.txt
  step goldens 0 script/goldens
fi
step goldens-fail 1 script/goldens --planted

if [ "$soak" -eq 1 ]; then
  # Seed 2 is the one that used to diverge (fleet losses depended on map
  # order); the rest widen the net. All eight run at once.
  seeds="1 2 3 4 5 6 7 8"
  start=$SECONDS
  for seed in $seeds; do
    bin/ltcore Tool/simdiverge --galaxy "$seed" --history "$seed" >"$log/soak-$seed.log" 2>&1 &
  done
  wait
  took=$((SECONDS - start))
  for seed in $seeds; do
    if grep -q "^simdiverge: no difference" "$log/soak-$seed.log"; then
      summary+=$(printf '  ok    %-13s %3ds\n' "soak-$seed" "$took")$'\n'
    else
      failures=$((failures + 1))
      summary+=$(printf '  FAIL  %-13s %3ds  the reloaded run differs\n' "soak-$seed" "$took")$'\n'
      echo "---- soak-$seed ----"
      tail -n 45 "$log/soak-$seed.log"
      echo
    fi
  done
fi

printf '%s' "$summary"
if [ "$failures" -gt 0 ]; then
  echo "check: $failures step(s) failed"
  exit 1
fi
echo "check: all steps passed$([ "$fast" -eq 1 ] && echo ' (window steps skipped)')"
