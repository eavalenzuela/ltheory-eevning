#!/usr/bin/env bash
# script/check: one command that says whether the tree is healthy.
#
#   script/check            run everything except the soak
#   script/check --fast     skip the steps that open a window
#   script/check --soak     also run the soaks (about 25 minutes)
#   script/check --on-desktop   let the windows open on the desktop
#
# The steps that open a window (about fifty of them, one after another)
# do so where nobody sees them: the whole run goes through
# script/offscreen, on a desktop of its own with no screen. Nothing
# appears on the real one unless --on-desktop asks for it.
#
# Steps:
#   types       bin/luaucheck: every script, strict mode
#   boundary    an engine call planted in an engine-free directory must be
#               rejected by the type checker
#   specs       bin/ltcore Tool/specs: the engine-free test suites
#   specs-fail  a planted failing suite must make the runner exit non-zero
#   sounds      script/soundgen --check: every sound a script names is
#               there (the engine plays silence for a missing one and says
#               nothing), and the list of made sounds matches what is made
#   launch-*    bin/launch must exit 0 for a clean app, 1 for a script
#               error, and with 128 + the signal for a crash or a failed
#               assertion
#   game-flight the game app flies the M1 loop (test/scenario/flight.txt):
#               undock, warp, orbit, jump, dock, and a save taken in mid-warp
#               that must play out to the same state when loaded
#   game-combat the game app plays the M2 loop (test/scenario/combat.txt):
#               fit a module, fight the pirate at a belt, loot its wreck,
#               lose the ship and get home in the capsule
#   game-economy  the game app plays the M3 loop through its station screens
#               (test/scenario/economy.txt): mine, refine, build ammunition,
#               sell it by standing order, buy a hull, train for it, board it
#   game-arms   a hull of our own design carries its fitted weapons on its
#               hardpoints, and its turret comes to bear (test/scenario/arms.txt)
#   game-starbase  a pilot puts up a starbase through the game's screens
#               (test/scenario/starbase.txt): buy a tower, fuel and an array,
#               anchor the tower at a moon, moor, fuel it, anchor the array,
#               refine there
#   game-colony  a pilot works a planet through the game's screens
#               (test/scenario/colony.txt): buy a command centre, put it
#               down, raise an extractor and a processor, take goods up
#   game-lawless  a Courier goes out through low security into lawless space
#               (test/scenario/lawless.txt): the packs that come to a belt
#               there, in the pirates' own hulls, and the rare ores
#   game-menu   the menus and save slots (test/scenario/menu.txt): a new
#               game from a seed, saved, loaded and deleted through the
#               menus, and the assets window
#   game-galaxy  a galaxy of forty systems (test/scenario/galaxy.txt): the
#               star map, a destination, and the autopilot flying there
#   game-traffic  the other ships about (test/scenario/traffic.txt): haulers
#               and patrols at a homeworld, and a pilot marked for firing
#               on one
#   game-missions  the jobs a station offers (test/scenario/missions.txt):
#               taken, one filled and paid, one given up
#   game-sites  sites on nobody's chart (test/scenario/sites.txt): a
#               vapour field and a hidden belt found with the scanner,
#               and a warp to the first
#   game-gas    gas and what it is for (test/scenario/gas.txt): a
#               harvester fitted, a cloud drawn off, the gas made into
#               a booster, and the booster taken
#   game-vault  a listening post's vault (test/scenario/vault.txt): its
#               bigger lock looked at, then played inside its clock,
#               and the vault looted
#   game-courier  a courier contract (test/scenario/courier.txt): the
#               sixth agent's first level taken, its crates flown a
#               jump by the autopilot, and paid where they are delivered
#   game-errand  a hired pilot sent to buy (test/scenario/errand.txt):
#               the Market tab says where else a thing is to be had,
#               a pilot is sent for a thousand, and brings them back
#   game-cloak  a cloak as its pilot sees it (test/scenario/cloak.txt): it
#               will not run by a station, at a belt the ship is drawn
#               as a ghost with nothing mounted, and off it is itself
#   game-blackops  a hull with a cloak of its own (test/scenario/blackops.txt):
#               the Orun's Skiver, with no device fitted, cloaks by its
#               key and comes out of it by its button
#   game-moon   a tower drilling its moon (test/scenario/moon.txt): a
#               moon with something under it found, a tower and a drill
#               anchored there, and an hour's worth in its hangar; then
#               a reactor anchored, and a batch of a composite made
#   game-orders  an order's price changed (test/scenario/orders.txt): a
#               sell order placed, its price set to another from the
#               list of the pilot's orders, and the order cancelled
#   game-contracts  a station's board (test/scenario/contracts.txt): a
#               lot bought, a want delivered, and a blueprint copy put
#               up, called off, and put up again cheap and sold
#   game-breakoff  a pirate that breaks off (test/scenario/breakoff.txt):
#               one badly hurt warps away with no wreck and no bounty,
#               and one held by a warp disruptor cannot
#   game-home   home (test/scenario/home.txt): a berth taken aboard a
#               Kethri colony ship, the ship and the capsule lost, and
#               the pilot waking there
#   game-history  a price's history (test/scenario/history.txt): a month
#               of a mineral's price at a station, bought dear one day
#               and sold cheap another, on the Market tab's History side
#   game-tackle  holding another ship (test/scenario/tackle.txt): a
#               entanglement projector and a warp disruptor fitted and used on a pirate
#   game-salvage  salvaging (test/scenario/salvage.txt): a salvager fitted,
#               a wreck stripped, and then looted
#   game-rigs   rigs (test/scenario/rigs.txt): one built of salvage, fitted,
#               and destroyed by taking it out
#   game-drones  drones (test/scenario/drones.txt): one launched, fighting
#               beside its ship, and called back
#   game-fleet  a hired pilot (test/scenario/fleet.txt): hired, given a ship,
#               out to a belt with the player, a pirate destroyed, a jump
#   game-miner  a hired pilot set to mine (test/scenario/miner.txt): a hold of
#               ore brought in to the station while the player sits docked
#   game-keys   flying by the keyboard (test/scenario/keys.txt): stop, warp,
#               pick out a pirate, lock, fire and hold it, dock, by keys alone
#   game-invent  invention (test/scenario/invent.txt): a tech 2 blueprint
#               tried for from a plain one and two datacores
#   game-hack   hacking (test/scenario/hack.txt): a data analyzer fitted, a
#               sealed hold's lock given up, played and won, and the hold looted
#   game-assault  an assault on a pirate camp (test/scenario/assault.txt):
#               the job taken, two waves destroyed at its camp, and paid
#   game-camp   a camp of two rooms, to raze (test/scenario/camp.txt): the first
#               cleared, its gate gone through, and what the camp is built of
#               destroyed in the second
#   game-defence  a defence job (test/scenario/defence.txt): a survey rig
#               held against everybody who comes for it and the job paid,
#               then the next one's rig lost and the job with it
#   game-escort  an escort (test/scenario/escort.txt): a tender seen out
#               of its place while pirates come for it, and the job paid
#   game-siege  a tower under siege (test/scenario/siege.txt): sealed
#               when its shield is failing, the siege broken when it opens,
#               and then the tower lost
#   game-carrier  a carrier (test/scenario/carrier.txt): ten fighters
#               launched and called back, and a jump by its drive from
#               the map
#   game-keep   a moon the pirates hold (test/scenario/keep.txt): their
#               tower sealed when its shield is failing, opened and
#               destroyed, and the pilot's own anchored at the moon
#   game-convoy  a convoy (test/scenario/convoy.txt): a tender seen out of
#               its place, followed to the station the job is from, and
#               seen in to dock past the wave that was waiting there
#   game-patrol  a hired pilot left to patrol a belt (test/scenario/patrol.txt):
#               pirates come for them with the player docked, and are seen off
#   game-dig    a mining contract (test/scenario/dig.txt): taken, its
#               pocket a jump away mined out, and the ore brought in
#   game-haul   a hired pilot set to haul (test/scenario/haul.txt): ore
#               carried to another station and sold there, and more after
#   game-dscan  the directional scanner (test/scenario/dscan.txt): all
#               round, in a cone pointed at something or by the camera, and
#               at a short range, with structures on it; and a marked place
#               given a name
#   game-away   time (test/scenario/away.txt): run faster at a station only,
#               and training that goes on while the game is not played
#   game-warp   the ends of a warp (test/scenario/warp.txt): the station left
#               is seen falling away, and the belt's rocks coming up ahead
#   game-context the right-click menu (test/scenario/context.txt): brought up
#               on the overview, and orbit, keep and warp at a distance
#               picked from it
#   game-nomads the Kethri's colony ships (test/scenario/nomads.txt): one
#               boarded in a galaxy of forty, left, docked at as the ship
#               it is, ridden to its next system and left there
#   game-targets  several targets at once (test/scenario/targets.txt): two
#               ships locked, the first the pilot's target, another picked
#               by its panel, and the camera following whichever it is
#   game-nimia  a hull of the Nimia's (test/scenario/nimia.txt): their
#               frigate has no shield and takes no shield module, and
#               half its armour and hull come back by themselves
#   game-careers  the career agents (test/scenario/careers.txt): a new
#               pilot takes lessons from two of them, does three, reports
#               each and is paid, and reads one again in space
#   game-corporation  a corporation (test/scenario/corporation.txt): founded
#               under a name, paid into, and its account paying for three
#               pilots where Leadership alone commands one
#   game-sights  what is seen and pointed at (test/scenario/sights.txt): a
#               double click in space flies the ship, another ship is drawn
#               going into warp, the planets turn, and where the pilot is
#               next to go is picked out on the overview
#   game-pace   the game app must draw at least thirty frames a second just
#               outside the home station (test/scenario/pace.txt)
#   goldens     script/goldens: screenshots of the stored scenes must match
#               their images
#   goldens-fail  two made-up images that differ must be reported as differing
#   soak-N      (--soak) the 400-system strategic simulation, run in
#               memory and run with a save and load every 97 ticks, must
#               not differ over 40,000 ticks (four and a half game days,
#               wars included), for each of eight seeds in
#               parallel
#   econ-sweep  (--soak) script/econsweep: the galaxy's economy, with
#               fixed borders, must pass every threshold on 16 seeds over
#               30 game days
#   faction-sweep  (--soak) script/factionsweep: the powers, their wars
#               and the pirates on that economy must pass every threshold
#               on 32 seeds over 30 game days
#
# The planted failures matter as much as the real checks: they prove that
# a failure cannot be reported as success. Exits 0 only if every step did
# what it should. Build first (python3 configure.py build).

set -u
cd "$(dirname "$0")/.."

fast=0
soak=0
desktop=0
for arg in "$@"; do
  case "$arg" in
    --fast) fast=1 ;;
    --soak) soak=1 ;;
    --on-desktop) desktop=1 ;;
    *) echo "usage: script/check [--fast] [--soak] [--on-desktop]"; exit 2 ;;
  esac
done

# Windows are opened where nobody sees them (script/offscreen), unless
# they are asked for; and bin/launch is told so, which would otherwise
# send each of its own runs there.
if [ "$desktop" -eq 1 ]; then
  export LT_OFFSCREEN=desktop
elif [ "$fast" -eq 0 ] && [ -z "${LT_OFFSCREEN:-}" ]; then
  exec script/offscreen script/check "$@"
fi

# The discrete GPU, where this machine has one; harmless elsewhere.
: "${DRI_PRIME:=1}"
export DRI_PRIME

log=$(mktemp -d)
planted=resource/script/Tool/_planted_engine_call.luau
trap 'rm -rf "$log" "$planted"' EXIT

failures=0
summary=""

# step NAME EXPECTED-STATUS COMMAND...
step() {
  local name=$1 expected=$2
  shift 2
  local start=$SECONDS
  "$@" >"$log/$name.log" 2>&1
  local status=$?
  local took=$((SECONDS - start))
  if [ "$status" -eq "$expected" ]; then
    summary+=$(printf '  ok    %-13s %3ds\n' "$name" "$took")$'\n'
  else
    failures=$((failures + 1))
    summary+=$(printf '  FAIL  %-13s %3ds  exit %d, expected %d\n' "$name" "$took" "$status" "$expected")$'\n'
    echo "---- $name: exit $status, expected $expected ----"
    tail -n 40 "$log/$name.log"
    echo
  fi
}

for tool in bin/luaucheck bin/ltcore bin/launch; do
  if [ ! -x "$tool" ]; then
    echo "script/check: $tool is missing; run python3 configure.py build"
    exit 2
  fi
done

step types 0 bin/luaucheck

cat >"$planted" <<'LUAU'
--!strict
-- Written by script/check and deleted afterwards: engine-free code may not
-- call the engine, so this must fail the type check.
return Object_Universe(1, 0)
LUAU
step boundary 1 bin/luaucheck --no-generate "$planted"
rm -f "$planted"

step specs 0 bin/ltcore Tool/specs
step specs-fail 1 bin/ltcore Tool/specs --file Tool/selftest/failing.planted
step sounds 0 script/soundgen --check

if [ "$fast" -eq 0 ]; then
  step launch-pass 0 timeout 120 bin/launch selftest/pass
  step launch-error 1 timeout 120 bin/launch selftest/error
  step launch-segv 139 timeout 120 bin/launch selftest/pass --selftest segv
  step launch-assert 134 timeout 120 bin/launch selftest/pass --selftest assert
  step game-flight 0 timeout 600 bin/launch game --no-present --fixed-step 60 --timeout 500 \
    --script test/scenario/flight.txt
  step game-combat 0 timeout 600 bin/launch game --no-present --fixed-step 60 --timeout 500 \
    --script test/scenario/combat.txt
  step game-economy 0 timeout 600 bin/launch game --no-present --fixed-step 60 --timeout 500 \
    --script test/scenario/economy.txt
  step game-arms 0 timeout 700 bin/launch game --no-present --fixed-step 60 --timeout 600 \
    --script test/scenario/arms.txt
  step game-starbase 0 timeout 400 bin/launch game --no-present --fixed-step 60 --timeout 300 \
    --script test/scenario/starbase.txt
  step game-colony 0 timeout 400 bin/launch game --no-present --fixed-step 60 --timeout 300 \
    --script test/scenario/colony.txt
  step game-lawless 0 timeout 500 bin/launch game --no-present --fixed-step 60 --timeout 400 \
    --script test/scenario/lawless.txt
  step game-menu 0 timeout 400 bin/launch game --no-present --fixed-step 60 --timeout 300 \
    --script test/scenario/menu.txt
  step game-galaxy 0 timeout 700 bin/launch game --no-present --fixed-step 60 --timeout 600 \
    --script test/scenario/galaxy.txt
  step game-traffic 0 timeout 700 bin/launch game --no-present --fixed-step 60 --timeout 600 \
    --script test/scenario/traffic.txt
  step game-missions 0 timeout 400 bin/launch game --no-present --fixed-step 60 --timeout 300 \
    --script test/scenario/missions.txt
  step game-courier 0 timeout 500 bin/launch game --no-present --fixed-step 60 --timeout 400 \
    --script test/scenario/courier.txt
  step game-errand 0 timeout 400 bin/launch game --no-present --fixed-step 60 --timeout 300 \
    --script test/scenario/errand.txt
  step game-cloak 0 timeout 400 bin/launch game --no-present --fixed-step 60 --timeout 300 \
    --script test/scenario/cloak.txt
  step game-blackops 0 timeout 400 bin/launch game --no-present --fixed-step 60 --timeout 300 \
    --script test/scenario/blackops.txt
  step game-moon 0 timeout 700 bin/launch game --no-present --fixed-step 60 --timeout 600 \
    --script test/scenario/moon.txt
  step game-orders 0 timeout 300 bin/launch game --no-present --fixed-step 60 --timeout 200 \
    --script test/scenario/orders.txt
  step game-history 0 timeout 300 bin/launch game --no-present --fixed-step 60 --timeout 200 \
    --script test/scenario/history.txt
  step game-home 0 timeout 900 bin/launch game --no-present --fixed-step 60 --timeout 800 \
    --script test/scenario/home.txt
  step game-contracts 0 timeout 500 bin/launch game --no-present --fixed-step 60 --timeout 400 \
    --script test/scenario/contracts.txt
  step game-breakoff 0 timeout 600 bin/launch game --no-present --fixed-step 60 --timeout 500 \
    --script test/scenario/breakoff.txt
  step game-sites 0 timeout 400 bin/launch game --no-present --fixed-step 60 --timeout 300 \
    --script test/scenario/sites.txt
  step game-tackle 0 timeout 500 bin/launch game --no-present --fixed-step 60 --timeout 400 \
    --script test/scenario/tackle.txt
  step game-salvage 0 timeout 500 bin/launch game --no-present --fixed-step 60 --timeout 400 \
    --script test/scenario/salvage.txt
  step game-rigs 0 timeout 500 bin/launch game --no-present --fixed-step 60 --timeout 400 \
    --script test/scenario/rigs.txt
  step game-drones 0 timeout 600 bin/launch game --no-present --fixed-step 60 --timeout 500 \
    --script test/scenario/drones.txt
  step game-fleet 0 timeout 700 bin/launch game --no-present --fixed-step 60 --timeout 600 \
    --script test/scenario/fleet.txt
  step game-miner 0 timeout 700 bin/launch game --no-present --fixed-step 60 --timeout 600 \
    --script test/scenario/miner.txt
  step game-keys 0 timeout 500 bin/launch game --no-present --fixed-step 60 --timeout 400 \
    --script test/scenario/keys.txt
  step game-invent 0 timeout 400 bin/launch game --no-present --fixed-step 60 --timeout 300 \
    --script test/scenario/invent.txt
  step game-hack 0 timeout 400 bin/launch game --no-present --fixed-step 60 --timeout 300 \
    --script test/scenario/hack.txt
  step game-vault 0 timeout 300 bin/launch game --no-present --fixed-step 60 --timeout 240 \
    --script test/scenario/vault.txt
  step game-gas 0 timeout 300 bin/launch game --no-present --fixed-step 60 --timeout 240 \
    --script test/scenario/gas.txt
  step game-assault 0 timeout 600 bin/launch game --no-present --fixed-step 60 --timeout 500 \
    --script test/scenario/assault.txt
  step game-camp 0 timeout 700 bin/launch game --no-present --fixed-step 60 --timeout 640 \
    --script test/scenario/camp.txt
  step game-defence 0 timeout 400 bin/launch game --no-present --fixed-step 60 --timeout 340 \
    --script test/scenario/defence.txt
  step game-escort 0 timeout 400 bin/launch game --no-present --fixed-step 60 --timeout 340 \
    --script test/scenario/escort.txt
  step game-convoy 0 timeout 500 bin/launch game --no-present --fixed-step 60 --timeout 440 \
    --script test/scenario/convoy.txt
  step game-siege 0 timeout 400 bin/launch game --no-present --fixed-step 60 --timeout 340 \
    --script test/scenario/siege.txt
  step game-keep 0 timeout 400 bin/launch game --no-present --fixed-step 60 --timeout 340 \
    --script test/scenario/keep.txt
  step game-carrier 0 timeout 500 bin/launch game --no-present --fixed-step 60 --timeout 440 \
    --script test/scenario/carrier.txt
  step game-patrol 0 timeout 600 bin/launch game --no-present --fixed-step 60 --timeout 500 \
    --script test/scenario/patrol.txt
  step game-dig 0 timeout 800 bin/launch game --no-present --fixed-step 60 --timeout 740 \
    --script test/scenario/dig.txt
  step game-haul 0 timeout 500 bin/launch game --no-present --fixed-step 60 --timeout 400 \
    --script test/scenario/haul.txt
  step game-dscan 0 timeout 400 bin/launch game --no-present --fixed-step 60 --timeout 300 \
    --script test/scenario/dscan.txt
  step game-away 0 timeout 300 bin/launch game --no-present --fixed-step 60 --timeout 240 \
    --script test/scenario/away.txt
  step game-warp 0 timeout 300 bin/launch game --no-present --fixed-step 60 --timeout 240 \
    --script test/scenario/warp.txt
  step game-context 0 timeout 400 bin/launch game --no-present --fixed-step 60 --timeout 340 \
    --script test/scenario/context.txt
  step game-nomads 0 timeout 400 bin/launch game --no-present --fixed-step 60 --timeout 340 \
    --script test/scenario/nomads.txt
  step game-targets 0 timeout 400 bin/launch game --no-present --fixed-step 60 --timeout 300 \
    --script test/scenario/targets.txt
  step game-nimia 0 timeout 400 bin/launch game --no-present --fixed-step 60 --timeout 340 \
    --script test/scenario/nimia.txt
  step game-careers 0 timeout 400 bin/launch game --no-present --fixed-step 60 --timeout 340 \
    --script test/scenario/careers.txt
  step game-corporation 0 timeout 300 bin/launch game --no-present --fixed-step 60 --timeout 240 \
    --script test/scenario/corporation.txt
  step game-sights 0 timeout 500 bin/launch game --no-present --fixed-step 60 --timeout 440 \
    --script test/scenario/sights.txt
  step game-pace 0 timeout 200 bin/launch game --no-present --fixed-step 60 --timeout 150 \
    --script test/scenario/pace.txt
  step goldens 0 script/goldens
fi
step goldens-fail 1 script/goldens --planted

if [ "$soak" -eq 1 ]; then
  # Eight histories at once. (In the prototype one seed in five diverged:
  # fleet losses depended on the order a map gave its keys.)
  seeds="1 2 3 4 5 6 7 8"
  start=$SECONDS
  for seed in $seeds; do
    bin/ltcore Tool/simdiverge --galaxy "$seed" --history "$seed" --ticks 40000 >"$log/soak-$seed.log" 2>&1 &
  done
  wait
  took=$((SECONDS - start))
  for seed in $seeds; do
    if grep -q "^simdiverge: no difference" "$log/soak-$seed.log"; then
      summary+=$(printf '  ok    %-13s %3ds\n' "soak-$seed" "$took")$'\n'
    else
      failures=$((failures + 1))
      summary+=$(printf '  FAIL  %-13s %3ds  the reloaded run differs\n' "soak-$seed" "$took")$'\n'
      echo "---- soak-$seed ----"
      tail -n 45 "$log/soak-$seed.log"
      echo
    fi
  done
  # The galaxy's economy, judged on 16 seeds over 30 game days; then the
  # powers on top of it, on 32.
  step econ-sweep 0 script/econsweep --out "$log/econ"
  step faction-sweep 0 script/factionsweep --out "$log/faction"
fi

printf '%s' "$summary"
if [ "$failures" -gt 0 ]; then
  echo "check: $failures step(s) failed"
  exit 1
fi
echo "check: all steps passed$([ "$fast" -eq 1 ] && echo ' (window steps skipped)')"
