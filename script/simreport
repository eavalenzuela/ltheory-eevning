#!/usr/bin/env python3
"""script/simreport: turn a simulation sweep into one HTML page.

    script/simreport DIR

DIR is a sweep directory written by script/simsweep (seed-N/result.txt and
seed-N/series.csv per seed). Writes DIR/report.html: the scorecard of every
check on every seed, and for the chosen seed the time series behind it.
The page is self-contained; open it in a browser.

Chart conventions (kept on purpose): one y-axis per chart; two series at
most share a plot, more are drawn as small multiples in one colour; every
chart has a table view and a hover readout; pass and fail are an icon and
a word, never colour alone.
"""

import csv
import json
import os
import sys

TICKS_PER_DAY = 8640
MAX_POINTS = 240


def read_result(path):
    info, checks = {}, []
    with open(path) as f:
        for line in f:
            line = line.rstrip("\n")
            if line.startswith("check="):
                name, value, limit, status = line[6:].split("|")
                checks.append({"name": name, "value": float(value), "limit": limit, "ok": status == "ok"})
            elif "=" in line:
                key, value = line.split("=", 1)
                info[key] = value
    return info, checks


def read_series(path):
    """{series: {key: [values]}} and the tick of each sample, thinned to MAX_POINTS."""
    ticks, index, data = [], {}, {}
    with open(path, newline="") as f:
        for row in csv.DictReader(f):
            tick = int(row["tick"])
            if tick not in index:
                index[tick] = len(ticks)
                ticks.append(tick)
            values = data.setdefault(row["series"], {}).setdefault(row["key"], [])
            while len(values) < index[tick]:
                values.append(None)
            values.append(float(row["value"]))
    step = max(1, -(-len(ticks) // MAX_POINTS))
    keep = list(range(0, len(ticks), step))
    if keep and keep[-1] != len(ticks) - 1:
        keep.append(len(ticks) - 1)

    def thin(values):
        return [round(values[i], 4) if i < len(values) and values[i] is not None else None for i in keep]

    return {
        "days": [round(ticks[i] / TICKS_PER_DAY, 4) for i in keep],
        "series": {s: {k: thin(v) for k, v in keys.items()} for s, keys in data.items()},
    }


def main():
    if len(sys.argv) != 2:
        print(__doc__)
        return 2
    root = sys.argv[1]
    seeds = sorted(
        (int(name[5:]) for name in os.listdir(root)
         if name.startswith("seed-") and os.path.isfile(os.path.join(root, name, "result.txt"))))
    if not seeds:
        print(f"simreport: no seed-N/result.txt under {root}")
        return 2

    runs = {}
    for seed in seeds:
        info, checks = read_result(os.path.join(root, f"seed-{seed}", "result.txt"))
        run = read_series(os.path.join(root, f"seed-{seed}", "series.csv"))
        run["info"], run["checks"] = info, checks
        runs[str(seed)] = run

    first = runs[str(seeds[0])]["info"]
    data = {
        "name": os.path.basename(os.path.normpath(root)),
        "seeds": seeds,
        "ticks": int(first.get("ticks", 0)),
        "systems": int(first.get("systems", 0)),
        "runs": runs,
    }
    # "</" must not appear inside a script element.
    payload = json.dumps(data, separators=(",", ":")).replace("</", "<\\/")
    out = os.path.join(root, "report.html")
    with open(out, "w") as f:
        f.write(PAGE.replace("/*DATA*/null", payload))
    print(f"simreport: wrote {out} ({os.path.getsize(out) // 1024} KB, {len(seeds)} seeds)")
    return 0


PAGE = r"""<!doctype html>
