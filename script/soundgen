#!/usr/bin/env python3
"""script/soundgen: make the game's sounds from written descriptions.

The sounds are listed in resource/sound/made/sounds.txt, one to a line:

    name | seconds | once or loop | what it should sound like

Each is asked of ElevenLabs' text-to-sound-effects service, trimmed,
brought to a common loudness and written to resource/sound/made/<name>.ogg
(what came back is kept in cache/soundgen/<name>.mp3). A sound that is
there already is left alone unless it is named with --force: asking
again gives a different sound, and costs credits.

A line whose kind is 'music' is a piece of music, asked of the same
people's music service (instrumental, as long as the line says), faded
in and out at its ends and written the same way.

A sound can also be joined from two that are there, which asks nobody
for anything:

    name | seconds | join | FIRST then SECOND [after N]

SECOND (any sound under resource/sound) begins at the loudest moment of
FIRST (one of the sounds made here), or N seconds after it; FIRST is
heard until then, and fades out over the 'seconds' after.

    script/soundgen                 make every sound that is not there yet
    script/soundgen NAME...         make these (if not there yet)
    script/soundgen --force NAME... make these again
    script/soundgen --list          say what is listed and what is there
    script/soundgen --check         fail if a script names a sound that is
                                    not there (the engine plays silence for
                                    one, and says nothing), or if the list
                                    and resource/sound/made disagree; asks
                                    nobody for anything

The key is read from the environment (ELEVENLABS_API_KEY) or from .env
at the top of the repository, and is never printed. Nothing is sent but
the description, the length and whether it loops.
"""
import json
import os
import re
import struct
import subprocess
import sys
import urllib.error
import urllib.request

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
LIST = os.path.join(ROOT, "resource/sound/made/sounds.txt")
OUT = os.path.join(ROOT, "resource/sound/made")
RAW = os.path.join(ROOT, "cache/soundgen")
URL = "https://api.elevenlabs.io/v1/sound-generation?output_format=mp3_44100_128"
PEAK = {"once": -1.0, "loop": -4.0, "join": -1.0, "music": -3.0}    # dB: how loud the loudest moment of each is made
MUSIC = "https://api.elevenlabs.io/v1/music?output_format=mp3_44100_128"
SOUNDS = os.path.join(ROOT, "resource/sound")


def key():
    found = os.environ.get("ELEVENLABS_API_KEY")
    if not found and os.path.exists(os.path.join(ROOT, ".env")):
        for line in open(os.path.join(ROOT, ".env")):
            name, _, value = line.strip().partition("=")
            if name.strip() == "ELEVENLABS_API_KEY":
                found = value.strip().strip('"').strip("'")
    if not found:
        sys.exit("soundgen: no ELEVENLABS_API_KEY in the environment or in .env")
    return found


def listed():
    sounds = []
    for number, line in enumerate(open(LIST), 1):
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        parts = [part.strip() for part in line.split("|", 3)]
        if len(parts) != 4 or parts[2] not in PEAK:
            sys.exit(f"soundgen: {LIST}:{number}: expected 'name | seconds | once, loop, music or join | description'")
        sounds.append({"name": parts[0], "seconds": float(parts[1]), "kind": parts[2], "text": parts[3]})
    return sounds


def ffmpeg(*args):
    done = subprocess.run(["ffmpeg", "-hide_banner", "-y", *args], capture_output=True, text=True)
    if done.returncode != 0:
        sys.exit("soundgen: ffmpeg failed:\n" + done.stderr[-800:])
    return done.stderr


def peak(path):
    found = re.search(r"max_volume: (-?[0-9.]+) dB", ffmpeg("-i", path, "-af", "volumedetect", "-f", "null", "-"))
    return float(found.group(1)) if found else 0.0


def length(path):
    done = subprocess.run(["ffprobe", "-v", "error", "-show_entries", "format=duration", "-of", "default=nw=1:nk=1", path],
                          capture_output=True, text=True)
    return float(done.stdout.strip() or 0)


def loudest(path):
    """When a sound is at its loudest: the start of its loudest fiftieth of a second, in seconds."""
    raw = subprocess.run(["ffmpeg", "-hide_banner", "-v", "error", "-i", path, "-ac", "1", "-ar", "44100", "-f", "s16le", "-"],
                         capture_output=True).stdout
    samples = struct.unpack("<%dh" % (len(raw) // 2), raw[:len(raw) // 2 * 2])
    window = 882
    best, at = -1.0, 0
    for start in range(0, len(samples) - window, window):
        power = sum(sample * sample for sample in samples[start:start + window])
        if power > best:
            best, at = power, start
    return at / 44100


def join(sound):
    """A sound of two: the first up to its loudest moment, the second from then."""
    first, _, second = sound["text"].partition(" then ")
    second, _, later = second.partition(" after ")
    first, second = os.path.join(OUT, first.strip() + ".ogg"), os.path.join(SOUNDS, second.strip())
    for path in (first, second):
        if not os.path.exists(path):
            sys.exit(f"soundgen: {sound['name']}: there is no {os.path.relpath(path, ROOT)}")
    out = os.path.join(OUT, sound["name"] + ".ogg")
    os.makedirs(os.path.dirname(out), exist_ok=True)
    os.makedirs(RAW, exist_ok=True)
    at = loudest(first) + (float(later) if later.strip() else 0.0)
    mixed = os.path.join(RAW, "join.wav")
    ffmpeg("-i", first, "-i", second, "-filter_complex",
           f"[0:a]afade=t=out:st={at:.3f}:d={sound['seconds']:.3f}[a];[1:a]adelay={int(at * 1000)}:all=1[b];"
           "[a][b]amix=inputs=2:normalize=0:duration=longest[m]", "-map", "[m]", mixed)
    gain = PEAK["join"] - peak(mixed)
    ffmpeg("-i", mixed, "-af", f"volume={gain:.2f}dB", "-c:a", "libvorbis", "-q:a", "5", out)
    os.remove(mixed)
    print(f"  joined {sound['name']:<23} {length(out):5.2f} s  (the second begins at {at:.2f} s)")
    return 0


def ask(sound, secret):
    url = URL
    body = {"text": sound["text"], "duration_seconds": sound["seconds"], "prompt_influence": 0.5}
    if sound["kind"] == "loop":
        body["loop"] = True
    elif sound["kind"] == "music":
        url = MUSIC
        body = {"prompt": sound["text"], "music_length_ms": int(sound["seconds"] * 1000), "force_instrumental": True}
    request = urllib.request.Request(url, data=json.dumps(body).encode(), method="POST", headers={
        "xi-api-key": secret, "Content-Type": "application/json", "User-Agent": "soundgen/1"})
    try:
        with urllib.request.urlopen(request, timeout=900) as answer:
            # (the music service does not say what a piece cost: -1)
            return answer.read(), int(answer.headers.get("character-cost") or (-1 if sound["kind"] == "music" else 0))
    except urllib.error.HTTPError as error:
        sys.exit(f"soundgen: {sound['name']}: the service said {error.code}: {error.read()[:300].decode(errors='replace')}")


def make(sound, secret):
    raw = os.path.join(RAW, sound["name"] + ".mp3")
    out = os.path.join(OUT, sound["name"] + ".ogg")
    os.makedirs(os.path.dirname(raw), exist_ok=True)
    os.makedirs(os.path.dirname(out), exist_ok=True)
    data, cost = ask(sound, secret)
    open(raw, "wb").write(data)
    gain = PEAK[sound["kind"]] - peak(raw)
    if sound["kind"] == "music":
        # (in and out of silence at its ends, so that it can come round again)
        end = length(raw)
        ffmpeg("-i", raw, "-af", f"afade=t=in:st=0:d=2.5,afade=t=out:st={max(0.0, end - 4):.3f}:d=4,volume={gain:.2f}dB",
               "-c:a", "libvorbis", "-q:a", "4", out)
    elif sound["kind"] == "loop":
        # (as it came, but for its loudness: a loop's ends are made to meet)
        ffmpeg("-i", raw, "-af", f"volume={gain:.2f}dB", "-c:a", "libvorbis", "-q:a", "5", out)
    else:
        # (from its first noise, and faded out over its last instant)
        trimmed = raw[:-4] + ".wav"
        ffmpeg("-i", raw, "-af", f"silenceremove=start_periods=1:start_threshold=-48dB,volume={gain:.2f}dB", trimmed)
        end = length(trimmed)
        ffmpeg("-i", trimmed, "-af", f"afade=t=out:st={max(0.0, end - 0.06):.3f}:d=0.06", "-c:a", "libvorbis", "-q:a", "5", out)
        os.remove(trimmed)
    print(f"  made  {sound['name']:<24} {length(out):6.2f} s  " + (f"{cost:4d} credits" if cost >= 0 else "cost not said"))
    return max(cost, 0)


def check():
    """What is wrong: sounds the scripts name that are not there, sounds
    listed but not made, and sounds made but not listed."""
    wrong = []
    named = re.compile(r'"([A-Za-z0-9_/. -]+\.(?:ogg|wav))"')
    for folder, _, files in sorted(os.walk(os.path.join(ROOT, "resource/script"))):
        for file in sorted(files):
            if not file.endswith(".luau"):
                continue
            path = os.path.join(folder, file)
            for number, line in enumerate(open(path, encoding="utf-8", errors="replace"), 1):
                for name in named.findall(line):
                    if not os.path.exists(os.path.join(SOUNDS, name)):
                        wrong.append(f"{os.path.relpath(path, ROOT)}:{number}: no sound '{name}' in resource/sound")
    known = {sound["name"] for sound in listed()}
    for name in sorted(known):
        if not os.path.exists(os.path.join(OUT, name + ".ogg")):
            wrong.append(f"{os.path.relpath(LIST, ROOT)}: '{name}' is listed and has not been made")
    for folder, _, files in sorted(os.walk(OUT)):
        for file in sorted(files):
            name = os.path.relpath(os.path.join(folder, file), OUT)
            if name.endswith(".ogg") and name[:-4] not in known:
                wrong.append(f"resource/sound/made/{name}: made, and not listed in sounds.txt")
    return wrong


def main():
    args = sys.argv[1:]
    force = "--force" in args
    names = [arg for arg in args if not arg.startswith("--")]
    sounds = listed()
    known = {sound["name"] for sound in sounds}
    for name in names:
        if name not in known:
            sys.exit(f"soundgen: '{name}' is not listed in {LIST}")
    if "--check" in args:
        wrong = check()
        for line in wrong:
            print(line)
        print(f"soundgen: {len(wrong)} wrong" if wrong else "soundgen: every sound a script names is there, and the list and what is made agree")
        sys.exit(1 if wrong else 0)
    if "--list" in args:
        for sound in sounds:
            there = os.path.exists(os.path.join(OUT, sound["name"] + ".ogg"))
            print(f"  {'there' if there else '-----'}  {sound['name']:<24} {sound['seconds']:4.1f} s  {sound['kind']}")
        return
    if force and not names:
        sys.exit("soundgen: --force wants the names of the sounds to make again")
    spent = 0
    for sound in sounds:
        if names and sound["name"] not in names:
            continue
        if os.path.exists(os.path.join(OUT, sound["name"] + ".ogg")) and not force:
            continue
        # (what is joined comes after what it is joined from in the list)
        spent += join(sound) if sound["kind"] == "join" else make(sound, key())
    print(f"soundgen: {spent} credits spent (music not counted: the service does not say)")


main()
