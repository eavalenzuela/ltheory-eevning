#!/usr/bin/env python3
"""script/artgen: the game's art redrawn in its retro-anime manner.

The owner's direction, 2026-11-17: icons for modules and ships, and
splash art, are made from the game's own pictures (a ship as the
viewer shows it, cropped) by asking OpenAI's image generator to redraw
them in the manner of the portraits, without changing their shape.
Every picture made is the owner's to look at first: what comes back is
kept in cache/artgen/, and nothing is put into the game from here.

    script/artgen edit IN.png NAME [--style REF.png] [--size WxH]
                  [--quality low|medium|high] [--model M] [--say TEXT]
        redraw IN.png; written to cache/artgen/NAME.png, beside
        NAME.json (what was asked). REF.png, if given, is sent too, as
        the manner to draw in (one of the portraits). --say adds to what
        is asked (what the picture is of, say).
    script/artgen icon CAPTURE.png NAME [--say TEXT] [edit's options]
        an icon: the middle of a capture cut square (icons are square:
        the owner, 2026-11-17), redrawn at 1024 by 1024 with a portrait
        as the manner to draw in (portrait-36, unless --style says)
    script/artgen sheet NAME STYLE ROWS COLS SUBJECT... [--quality q] [--model M]
        a sheet of icons drawn from words alone, ROWS by COLS of them, one
        for each SUBJECT in reading order, in the manner STYLE says (see
        SHEET_STYLES), on no background; written to cache/artgen/NAME.png
        and cut into NAME-01.png, NAME-02.png ... (each square, about its
        mark). The owner, 2026-11-23: inventory icons, one for each kind of
        module, abstract marks, not pictures of the module, and on no
        background.
    script/artgen kinds [SHEET ...] [--style REF.png] [--quality q]
        the inventory's icons, a sheet at a time, from script/iconkinds.txt
        (every sheet, or those named); each sheet is drawn with REF.png
        (cache/artgen/icons-cel.png, the set the owner picked) as the set
        it belongs to, and cut into cache/artgen/kinds/KEY.png
    script/artgen install [--skip KEY|SHEET ...]
        put the icons of script/iconkinds.txt the owner has passed into
        the game: resource/texture/icons/{24,48,96}/KEY.png, and the list
        of them, Game/UI/IconSet.luau (the game draws the old sign for a
        kind not in it). --skip leaves out a kind, or a whole sheet, not
        passed yet.
    script/artgen glyphsheet NAME [--quality q]
        a sheet of the overview's signs from script/overviewglyphs.txt:
        white glyphs on black, keyed, tinted by the game; written to
        cache/artgen/overview-NAME.png (its keys in the .json beside it)
    script/artgen glyphs
        put the overview's signs into the game: every sheet of
        script/overviewglyphs.txt cut, the latest drawing of each kind
        and the tries picked, into resource/texture/glyphs/{16,24,32,64}
        as white with their see-through parts, and the list of them,
        Game/UI/GlyphSet.luau
    script/artgen recut NAME ROWS COLS
        cut a sheet made already again (asks nobody anything)
    script/artgen crop IN.png OUT.png X Y W H
        cut a piece out of a picture (a capture), asks nobody anything

The key is read from the environment (OPENAI_API_KEY) or from .env at
the top of the repository, and is never printed. Nothing is sent but
the pictures and the words asked.
"""
import base64
import json
import os
import sys
import time
import urllib.error
import urllib.request
import uuid

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
OUT = os.path.join(ROOT, "cache/artgen")
MODEL = "gpt-image-2"

# What every picture is asked to be. (Mine, 2026-11-17: to be tuned on
# the owner's word.)
STYLE = (
    "Redraw this picture as a hand-drawn retro anime illustration in the manner of late-1980s and early-1990s "
    "science-fiction anime and its mecha design sheets: confident black ink linework, flat cel shading in two or "
    "three tones, a limited, slightly muted palette, a faint grain of printed paper. "
    "It must stay the same object seen from the same angle: keep its exact silhouette, proportions and outline; "
    "keep every plate, fin, engine and turret where it is and the size it is; do not add, remove, reshape, "
    "straighten or tidy any part, and do not add details that are not there. Only the manner of drawing changes."
)
STYLE_REF = (
    " The second picture shows the manner to draw in (its linework, shading, palette and grain): take only its "
    "manner, none of its content."
)


def key():
    found = os.environ.get("OPENAI_API_KEY")
    if not found and os.path.exists(os.path.join(ROOT, ".env")):
        for line in open(os.path.join(ROOT, ".env")):
            line = line.strip()
            if line.startswith("OPENAI_API_KEY="):
                found = line.split("=", 1)[1].strip().strip('"').strip("'")
    if not found:
        sys.exit("artgen: no OPENAI_API_KEY in the environment or in .env")
    return found


def multipart(fields, files):
    boundary = uuid.uuid4().hex
    body = bytearray()
    for name, value in fields:
        body += f"--{boundary}\r\nContent-Disposition: form-data; name=\"{name}\"\r\n\r\n{value}\r\n".encode()
    for name, path in files:
        body += (f"--{boundary}\r\nContent-Disposition: form-data; name=\"{name}\"; filename=\"{os.path.basename(path)}\"\r\n"
                 "Content-Type: image/png\r\n\r\n").encode()
        body += open(path, "rb").read() + b"\r\n"
    body += f"--{boundary}--\r\n".encode()
    return bytes(body), f"multipart/form-data; boundary={boundary}"


def edit(args):
    if len(args) < 2:
        sys.exit(__doc__)
    source, name = args[0], args[1]
    options = {"--style": None, "--size": "1536x1024", "--quality": "high", "--model": MODEL, "--say": ""}
    rest = args[2:]
    while rest:
        flag = rest.pop(0)
        if flag not in options or not rest:
            sys.exit(f"artgen: what is '{flag}'?")
        options[flag] = rest.pop(0)
    prompt = STYLE + (STYLE_REF if options["--style"] else "") + (" " + options["--say"] if options["--say"] else "")
    fields = [("model", options["--model"]), ("prompt", prompt), ("size", options["--size"]),
              ("quality", options["--quality"]), ("n", "1")]
    files = [("image[]", source)] + ([("image[]", options["--style"])] if options["--style"] else [])
    body, kind = multipart(fields + [("input_fidelity", "high")], files)
    os.makedirs(OUT, exist_ok=True)
    started = time.time()
    for attempt in (1, 2):
        request = urllib.request.Request("https://api.openai.com/v1/images/edits", data=body,
                                         headers={"Authorization": "Bearer " + key(), "Content-Type": kind})
        try:
            answer = json.load(urllib.request.urlopen(request, timeout=600))
            break
        except urllib.error.HTTPError as error:
            said = error.read().decode(errors="replace")
            # (a model that does not take input_fidelity is asked again without it)
            if attempt == 1 and "input_fidelity" in said:
                body, kind = multipart(fields, files)
                continue
            sys.exit(f"artgen: the service said {error.code}: {said[:600]}")
    picture = base64.b64decode(answer["data"][0]["b64_json"])
    path = os.path.join(OUT, name + ".png")
    open(path, "wb").write(picture)
    json.dump({"source": source, "style": options["--style"], "model": options["--model"], "size": options["--size"],
               "quality": options["--quality"], "prompt": prompt, "usage": answer.get("usage"),
               "seconds": round(time.time() - started)}, open(os.path.join(OUT, name + ".json"), "w"), indent=1)
    print(f"artgen: {path} ({round(time.time() - started)} s)")


def crop(args):
    from PIL import Image
    if len(args) != 6:
        sys.exit(__doc__)
    x, y, w, h = (int(a) for a in args[2:])
    Image.open(args[0]).convert("RGB").crop((x, y, x + w, y + h)).save(args[1])


ICON_STYLE = os.path.join(ROOT, "resource/texture/portraits/portrait-36.png")


def hull_square(picture):
    """The square about the hull in a capture of the viewer's
    (Viewer.Ships): where its paint and metal are, and not the green of
    the sky or a star's point, with a margin."""
    small = picture.resize((picture.width // 4, picture.height // 4))
    w, h = small.size
    pixels = small.load()
    rows, cols = [0] * h, [0] * w
    for y in range(h):
        for x in range(w):
            r, g, b = pixels[x, y]
            # (the sky is dark, or green with little blue in it)
            if r + g + b > 110 and b > 0.55 * g:
                rows[y] += 1
                cols[x] += 1
    # (a line with only a star or two on it is not the hull)
    ys = [y for y in range(h) if rows[y] >= 3]
    xs = [x for x in range(w) if cols[x] >= 3]
    if not xs or not ys:
        sys.exit("artgen: no hull found in the capture")
    x0, x1, y0, y1 = xs[0] * 4, xs[-1] * 4 + 4, ys[0] * 4, ys[-1] * 4 + 4
    side = int(max(x1 - x0, y1 - y0) * 1.12)
    cx, cy = (x0 + x1) // 2, (y0 + y1) // 2
    return cx - side // 2, cy - side // 2, side


def icon(args):
    from PIL import Image
    if len(args) < 2:
        sys.exit(__doc__)
    capture, name = args[0], args[1]
    os.makedirs(OUT, exist_ok=True)
    square = os.path.join(OUT, name + ".source.png")
    picture = Image.open(capture).convert("RGB")
    x, y, side = hull_square(picture)
    # (a square that runs off the capture is filled out with the dark of space)
    cut = Image.new("RGB", (side, side), (4, 6, 5))
    cut.paste(picture.crop((max(0, x), max(0, y), min(picture.width, x + side), min(picture.height, y + side))),
              (max(0, -x), max(0, -y)))
    cut.save(square)
    rest = list(args[2:])
    if "--style" not in rest:
        rest += ["--style", ICON_STYLE]
    if "--size" not in rest:
        rest += ["--size", "1024x1024"]
    edit([square, name] + rest)


# The manners a sheet of icons is drawn in. (Mine, 2026-11-23, to try:
# the owner picks, or says otherwise.)
SHEET_STYLES = {
    "mono": (
        "Each icon is a small abstract symbol, in light silver-grey with a soft bevel and a faint inner glow, like a "
        "glyph engraved in brushed metal: a single colour, simple bold shapes that still read at 24 pixels."
    ),
    "cel": (
        "Each icon is a small abstract symbol drawn in the manner of late-1980s science-fiction anime design sheets: "
        "bold black ink outlines, flat cel shading in two tones of one muted colour per icon, a highlight stroke, "
        "simple shapes that still read at 24 pixels."
    ),
    "line": (
        "Each icon is a small abstract symbol drawn as luminous technical line art: thin and thick strokes of pale "
        "cyan-white light, no fill, a little glow, like a mark on a ship's console display; simple shapes that still "
        "read at 24 pixels."
    ),
}
SHEET = (
    "A sheet of {n} game interface icons, laid out in an even grid of {rows} rows and {cols} columns with wide empty "
    "space between them, every icon centred in its cell and the same size. {style} "
    "The icons are abstract symbols of what a ship's equipment does, not pictures of the equipment itself: no "
    "machinery drawn, no text, no letters, no numbers, no frames, tiles, circles or plates behind them, and no "
    "background at all. They must all be clearly one set. In reading order, the icons stand for: {subjects}."
)


def generate(prompt, size, quality, model, background):
    fields = {"model": model, "prompt": prompt, "size": size, "quality": quality, "n": 1}
    if background:
        fields["background"] = background
        fields["output_format"] = "png"
    started = time.time()
    request = urllib.request.Request("https://api.openai.com/v1/images/generations", data=json.dumps(fields).encode(),
                                     headers={"Authorization": "Bearer " + key(), "Content-Type": "application/json"})
    try:
        answer = json.load(urllib.request.urlopen(request, timeout=600))
    except urllib.error.HTTPError as error:
        return None, error.read().decode(errors="replace"), 0
    return answer, None, round(time.time() - started)


def cut(picture, rows, cols, keyed):
    """Each icon of a sheet, square, about its mark. The sheet's pieces
    (what is lit, joined) are found over the whole of it and each goes to
    the cell its middle lies in: a long gun that reaches into the next
    row stays with its ship, and a speck of a neighbour's glow is left
    out. A sheet on black (a model that will not leave the background
    out) is keyed: its dark goes clear."""
    from PIL import Image
    picture = picture.convert("RGBA")
    if keyed:
        pixels = picture.load()
        for y in range(picture.height):
            for x in range(picture.width):
                r, g, b, a = pixels[x, y]
                light = max(r, g, b)
                pixels[x, y] = (r, g, b, 0 if light < 18 else min(255, light * 3))
    step = 4
    alpha = picture.getchannel("A").resize((picture.width // step, picture.height // step))
    w, h = alpha.size
    lit = [[alpha.getpixel((x, y)) > 40 for x in range(w)] for y in range(h)]
    label = [[0] * w for _ in range(h)]
    pieces = {}
    for y0 in range(h):
        for x0 in range(w):
            if lit[y0][x0] and not label[y0][x0]:
                n = len(pieces) + 1
                stack, cells = [(x0, y0)], []
                label[y0][x0] = n
                while stack:
                    x, y = stack.pop()
                    cells.append((x, y))
                    for nx in (x - 1, x, x + 1):
                        for ny in (y - 1, y, y + 1):
                            if 0 <= nx < w and 0 <= ny < h and lit[ny][nx] and not label[ny][nx]:
                                label[ny][nx] = n
                                stack.append((nx, ny))
                pieces[n] = cells
    # (each piece to the cell of its middle; the cell's largest piece and
    # what is not a speck beside it are the icon)
    owned = {}
    for n, cells in pieces.items():
        mx = sum(x for x, _ in cells) / len(cells) / w
        my = sum(y for _, y in cells) / len(cells) / h
        owned.setdefault((min(rows - 1, int(my * rows)), min(cols - 1, int(mx * cols))), []).append(n)
    out = []
    for row in range(rows):
        for col in range(cols):
            mine = owned.get((row, col), [])
            largest = max((len(pieces[n]) for n in mine), default=0)
            mine = [n for n in mine if len(pieces[n]) >= max(2, largest * 0.02)]
            square = Image.new("RGBA", (256, 256), (0, 0, 0, 0))
            if mine:
                keep = set(mine)
                mask = Image.new("L", (w, h), 0)
                mp = mask.load()
                for n in keep:
                    for x, y in pieces[n]:
                        mp[x, y] = 255
                # (the glow about a piece goes with it)
                from PIL import ImageFilter
                mask = mask.filter(ImageFilter.MaxFilter(5)).resize(picture.size, Image.NEAREST)
                icon = picture.copy()
                icon.putalpha(Image.composite(icon.getchannel("A"), Image.new("L", picture.size, 0), mask))
                box = mask.getbbox()
                icon = icon.crop(box)
                side = int(max(icon.width, icon.height) * 1.1)
                framed = Image.new("RGBA", (side, side), (0, 0, 0, 0))
                framed.paste(icon, ((side - icon.width) // 2, (side - icon.height) // 2))
                square = framed.resize((256, 256), Image.LANCZOS)
            out.append(square)
    return out


def sheet(args):
    from PIL import Image
    import io
    if len(args) < 5:
        sys.exit(__doc__)
    name, style, rows, cols = args[0], args[1], int(args[2]), int(args[3])
    rest = args[4:]
    options = {"--quality": "high", "--model": MODEL}
    subjects = []
    while rest:
        word = rest.pop(0)
        if word in options and rest:
            options[word] = rest.pop(0)
        else:
            subjects.append(word)
    if style not in SHEET_STYLES:
        sys.exit(f"artgen: the manners are {', '.join(SHEET_STYLES)}")
    if len(subjects) != rows * cols:
        sys.exit(f"artgen: {rows} by {cols} is {rows * cols} icons, not {len(subjects)}")
    listed = "; ".join(f"{i + 1}. {s}" for i, s in enumerate(subjects))
    prompt = SHEET.format(n=len(subjects), rows=rows, cols=cols, style=SHEET_STYLES[style], subjects=listed)
    answer, said, seconds = generate(prompt, "1024x1024", options["--quality"], options["--model"], "transparent")
    keyed = False
    if answer is None:
        # (a model that will not draw on nothing draws on black, keyed out after)
        if "background" not in said:
            sys.exit(f"artgen: the service said: {said[:600]}")
        prompt += " Draw them on a plain, flat, pure black background."
        answer, said, seconds = generate(prompt, "1024x1024", options["--quality"], options["--model"], None)
        if answer is None:
            sys.exit(f"artgen: the service said: {said[:600]}")
        keyed = True
    os.makedirs(OUT, exist_ok=True)
    data = base64.b64decode(answer["data"][0]["b64_json"])
    path = os.path.join(OUT, name + ".png")
    open(path, "wb").write(data)
    for index, icon in enumerate(cut(Image.open(io.BytesIO(data)), rows, cols, keyed)):
        icon.save(os.path.join(OUT, f"{name}-{index + 1:02d}.png"))
    json.dump({"style": style, "model": options["--model"], "quality": options["--quality"], "keyed": keyed,
               "subjects": subjects, "prompt": prompt, "usage": answer.get("usage"), "seconds": seconds},
              open(os.path.join(OUT, name + ".json"), "w"), indent=1)
    print(f"artgen: {path} ({seconds} s{', keyed from black' if keyed else ''})")


KINDS = os.path.join(ROOT, "script/iconkinds.txt")
SET_REF = (
    " The picture given shows icons of the same set: draw these new ones exactly in its manner (the same outline "
    "weight, cel shading, glow, scale and spacing) so they sit beside it as one set, and take none of its subjects."
)


def kinds(args):
    from PIL import Image
    import io
    options = {"--style": os.path.join(OUT, "icons-cel.png"), "--quality": "high"}
    wanted = []
    rest = list(args)
    while rest:
        word = rest.pop(0)
        if word in options and rest:
            options[word] = rest.pop(0)
        else:
            wanted.append(word)
    sheets, current = [], None
    for line in open(KINDS):
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        if line.startswith("=="):
            current = (line[2:].strip(), [], [])
            sheets.append(current)
            continue
        if line.startswith("!!"):
            current[2].append(line[2:].strip())
            continue
        kind_, colour, subject = (part.strip() for part in line.split("|"))
        current[1].append((kind_, f"{subject} (in {colour})"))
    os.makedirs(os.path.join(OUT, "kinds"), exist_ok=True)
    for title, items, notes in sheets:
        if wanted and title not in wanted:
            continue
        side = next((n for n in (2, 3, 4) if n * n >= len(items)), None)
        if not side:
            sys.exit(f"artgen: the sheet '{title}' has {len(items)} kinds, more than 16")
        listed = "; ".join(f"{i + 1}. {subject}" for i, (_, subject) in enumerate(items))
        listed += "".join(f"; {i + 1}. (leave this cell empty)" for i in range(len(items), side * side))
        prompt = SHEET.format(n=side * side, rows=side, cols=side, style=SHEET_STYLES["cel"], subjects=listed) + SET_REF
        # (a note on the sheet, said to the model; the line that is the owner's word is not)
        prompt += "".join(" " + note for note in notes if not note.startswith("The owner"))
        prompt += " Draw them on a plain, flat, pure black background."
        fields = [("model", MODEL), ("prompt", prompt), ("size", "1024x1024"), ("quality", options["--quality"]), ("n", "1")]
        body, kind = multipart(fields, [("image[]", options["--style"])])
        started = time.time()
        request = urllib.request.Request("https://api.openai.com/v1/images/edits", data=body,
                                         headers={"Authorization": "Bearer " + key(), "Content-Type": kind})
        try:
            answer = json.load(urllib.request.urlopen(request, timeout=600))
        except urllib.error.HTTPError as error:
            sys.exit(f"artgen: the service said {error.code}: {error.read().decode(errors='replace')[:600]}")
        data = base64.b64decode(answer["data"][0]["b64_json"])
        name = "kinds-" + title.replace(" ", "-")
        open(os.path.join(OUT, name + ".png"), "wb").write(data)
        json.dump({"style": "cel", "reference": options["--style"], "keyed": True, "keys": [k for k, _ in items],
                   "prompt": prompt, "usage": answer.get("usage"), "seconds": round(time.time() - started)},
                  open(os.path.join(OUT, name + ".json"), "w"), indent=1)
        for (key_, _), icon in zip(items, cut(Image.open(io.BytesIO(data)), side, side, True)):
            icon.save(os.path.join(OUT, "kinds", key_ + ".png"))
        print(f"artgen: {name} ({round(time.time() - started)} s)", flush=True)


ICON_SIZES = (24, 48, 96)


def install(args):
    from PIL import Image
    skip = set()
    rest = list(args)
    while rest:
        flag = rest.pop(0)
        if flag != "--skip" or not rest:
            sys.exit(__doc__)
        skip.add(rest.pop(0))
    keys, sheet = [], None
    for line in open(KINDS):
        line = line.strip()
        if line.startswith("=="):
            sheet = line[2:].strip()
        elif line and not line.startswith(("#", "!!")):
            kind_ = line.split("|")[0].strip()
            if sheet not in skip and kind_ not in skip and kind_ not in keys:
                keys.append(kind_)
    made = []
    for kind_ in keys:
        source = os.path.join(OUT, "kinds", kind_ + ".png")
        if not os.path.exists(source):
            continue
        picture = Image.open(source).convert("RGBA")
        for size in ICON_SIZES:
            folder = os.path.join(ROOT, "resource/texture/icons", str(size))
            os.makedirs(folder, exist_ok=True)
            picture.resize((size, size), Image.LANCZOS).save(os.path.join(folder, kind_ + ".png"), optimize=True)
        made.append(kind_)
    with open(os.path.join(ROOT, "resource/script/Game/UI/IconSet.luau"), "w") as out:
        out.write("--!strict\n-- The inventory's icons that are in the game (resource/texture/icons),\n")
        out.write("-- written by script/artgen install: do not edit by hand.\n\nreturn {\n  sizes = { ")
        out.write(", ".join(str(size) for size in ICON_SIZES) + " },\n  kinds = {\n")
        for kind_ in sorted(made):
            out.write(f'    ["{kind_}"] = true,\n')
        out.write("  } :: { [string]: boolean },\n}\n")
    print(f"artgen: {len(made)} icons put in")


def recut(args):
    from PIL import Image
    if len(args) != 3:
        sys.exit(__doc__)
    name, rows, cols = args[0], int(args[1]), int(args[2])
    said = json.load(open(os.path.join(OUT, name + ".json")))
    icons = cut(Image.open(os.path.join(OUT, name + ".png")), rows, cols, said.get("keyed"))
    # (a sheet of the inventory's kinds is cut into its kinds' names)
    names = [os.path.join("kinds", k) for k in said["keys"]] if "keys" in said else \
        [f"{name}-{index + 1:02d}" for index in range(len(icons))]
    for path, icon in zip(names, icons):
        icon.save(os.path.join(OUT, path + ".png"))


GLYPHS = os.path.join(ROOT, "script/overviewglyphs.txt")
GLYPH_SIZES = (16, 24, 32, 64)
GLYPH_SHEET = (
    "A sheet of {n} tiny game interface glyphs for a space game's overview and in-space target brackets, in an even grid "
    "of {side} rows and {side} columns with wide empty space between them, each centred in its cell and the same size, on a "
    "plain, flat, pure black background. Every glyph is drawn ONLY in pure flat white: bold, even, thick strokes and small "
    "solid shapes, no shading, no gradients, no glow, no outline of another colour, no colour at all, so the game can tint "
    "it any colour. They must read at 16 pixels tall, so each is a very simple geometric mark of a few strokes, like a map "
    "symbol or a military unit symbol, with no fine detail. The picture given shows this game's ship class insignia: these "
    "glyphs are the same shapes reduced to plain white line marks.{ref} No text, letters or numbers, no frames or tiles "
    "behind them. In reading order: {subjects}."
)
# (the fitting screen's glyphs, a sheet whose name begins "damage" or "fitting": the
# overview's first and third sheets their manner, not the insignia)
GLYPH_FITTING = (
    "A sheet of {n} tiny game interface glyphs for a space game's fitting screen, in an even grid of {side} rows and {side} "
    "columns with wide empty space between them, each centred in its cell and the same size, on a plain, flat, pure black "
    "background. Every glyph is drawn ONLY in pure flat white: bold, even, thick strokes and small solid shapes, no shading, "
    "no gradients, no glow, no outline of another colour, no colour at all, so the game can tint it any colour. They must "
    "read at 16 pixels tall, so each is a very simple geometric mark of a few strokes, like a map symbol, with no fine "
    "detail. The pictures given show glyphs of this same set: draw these new ones exactly in their manner, stroke weight "
    "and scale, and take none of their subjects. No text, letters or numbers, no frames or tiles behind them. In reading "
    "order: {subjects}."
)
GLYPH_REF = (" The second picture shows glyphs of this same set: draw these new ones exactly in its manner, stroke weight "
             "and scale, and take none of its subjects.")


def glyph_sheets():
    sheets, picks, current = [], {}, None
    for line in open(GLYPHS):
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        if line.startswith("=="):
            current = (line[2:].strip(), [])
            sheets.append(current)
        elif line.startswith("=>"):
            target, source = (part.strip() for part in line[2:].split("|"))
            picks[target] = source
        else:
            key_, subject = (part.strip() for part in line.split("|", 1))
            current[1].append((key_, subject))
    return [sheet for sheet in sheets if sheet[1]], picks


def glyphsheet(args):
    options = {"--quality": "high"}
    rest, names = list(args), []
    while rest:
        word = rest.pop(0)
        if word in options and rest:
            options[word] = rest.pop(0)
        else:
            names.append(word)
    sheets, _ = glyph_sheets()
    first = sheets[0][0]
    for title, items in sheets:
        if title not in names:
            continue
        side = 3 if len(items) <= 9 else 4
        listed = "; ".join(f"{i + 1}. {subject}" for i, (_, subject) in enumerate(items))
        listed += "".join(f"; {i + 1}. (leave this cell empty)" for i in range(len(items), side * side))
        if title.startswith(("damage", "fitting")):
            prompt = GLYPH_FITTING.format(n=side * side, side=side, subjects=listed)
            images = [("image[]", os.path.join(OUT, f"overview-{name}.png")) for name in (first, "3")]
            if title != "damage":
                images.append(("image[]", os.path.join(OUT, "overview-damage.png")))
        else:
            prompt = GLYPH_SHEET.format(n=side * side, side=side, subjects=listed, ref=GLYPH_REF if title != first else "")
            images = [("image[]", os.path.join(OUT, "hulls-insignia2.png"))]
            if title != first:
                images.append(("image[]", os.path.join(OUT, f"overview-{first}.png")))
        fields = [("model", MODEL), ("prompt", prompt), ("size", "1024x1024"), ("quality", options["--quality"]), ("n", "1")]
        body, kind = multipart(fields, images)
        started = time.time()
        request = urllib.request.Request("https://api.openai.com/v1/images/edits", data=body,
                                         headers={"Authorization": "Bearer " + key(), "Content-Type": kind})
        try:
            answer = json.load(urllib.request.urlopen(request, timeout=600))
        except urllib.error.HTTPError as error:
            sys.exit(f"artgen: the service said {error.code}: {error.read().decode(errors='replace')[:600]}")
        out = os.path.join(OUT, f"overview-{title}")
        open(out + ".png", "wb").write(base64.b64decode(answer["data"][0]["b64_json"]))
        json.dump({"prompt": prompt, "keyed": True, "keys": [k for k, _ in items], "usage": answer.get("usage")},
                  open(out + ".json", "w"), indent=1)
        print(f"artgen: overview-{title} ({round(time.time() - started)} s)", flush=True)


def glyphs(args):
    from PIL import Image
    sheets, picks = glyph_sheets()
    drawn = {}
    for title, items in sheets:
        path = os.path.join(OUT, f"overview-{title}.png")
        if not os.path.exists(path):
            continue
        side = 3 if len(items) <= 9 else 4
        for (key_, _), picture in zip(items, cut(Image.open(path), side, side, True)):
            drawn[key_] = picture
    wanted = {k: k for k in drawn if "-" not in k}
    wanted.update(picks)
    made = []
    for kind_, source in sorted(wanted.items()):
        picture = drawn.get(source)
        if picture is None:
            continue
        # (white, its see-through parts as drawn: the game tints it)
        alpha = picture.convert("RGBA").getchannel("A")
        for size in GLYPH_SIZES:
            folder = os.path.join(ROOT, "resource/texture/glyphs", str(size))
            os.makedirs(folder, exist_ok=True)
            white = Image.new("RGBA", (size, size), (255, 255, 255, 0))
            white.putalpha(alpha.resize((size, size), Image.LANCZOS))
            white.save(os.path.join(folder, kind_ + ".png"), optimize=True)
        made.append(kind_)
    with open(os.path.join(ROOT, "resource/script/Game/UI/GlyphSet.luau"), "w") as out:
        out.write("--!strict\n-- The overview's signs that are in the game (resource/texture/glyphs),\n")
        out.write("-- written by script/artgen glyphs: do not edit by hand.\n\nreturn {\n  sizes = { ")
        out.write(", ".join(str(size) for size in GLYPH_SIZES) + " },\n  kinds = {\n")
        for kind_ in sorted(made):
            out.write(f'    ["{kind_}"] = true,\n')
        out.write("  } :: { [string]: boolean },\n}\n")
    print(f"artgen: {len(made)} signs put in")


if __name__ == "__main__":
    if len(sys.argv) < 2 or sys.argv[1] not in ("edit", "crop", "icon", "sheet", "recut", "kinds", "install", "glyphsheet", "glyphs"):
        sys.exit(__doc__)
    {"edit": edit, "crop": crop, "icon": icon, "sheet": sheet, "recut": recut, "kinds": kinds, "install": install, "glyphsheet": glyphsheet, "glyphs": glyphs}[sys.argv[1]](sys.argv[2:])
