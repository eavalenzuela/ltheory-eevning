#include global.jsl

#output 0 vec4 fragment_color0
#output 1 vec4 fragment_color1

FRAG_IN float linearDepth;
FRAG_IN vec2 uv;
FRAG_IN vec3 vertpos;
FRAG_IN vec3 vertnormal;
FRAG_IN vec3 vertcolor;

uniform int prepass;

/* (what a shader gives is a number, whatever it worked out: global.jsl) */
/* (Trial 1 of 3, 2026-11-14: a shader that only has a colour to give
   says in so many words that it gives the surface nothing. Left unsaid
   it is whatever the driver likes, which is the likely cause of the
   dark specks on an AMD card. It went out once with two other changes
   and the sky went black in warp there: it is back by itself to see
   whether it was the one.) */
#define RETURN(x)  { fragment_color0 = asNumber(x); fragment_color1 = vec4(0.0); return; }

const int MATERIAL_PHONG = 0;
const int MATERIAL_COOKT = 1;
const int MATERIAL_ICE = 2;
const int MATERIAL_NOSHADE = 3;
/* What is built (hulls, stations, towers, all metal): lit as MATERIAL_COOKT
   is, and in the cel looks drawn in flat tones and inked, where rock,
   ice, planets and the sky stay as they are (the owner, 2026-11-17:
   "Cel shading should apply to all manmade items. Backgrounds and
   environments stay photoreal"). */
const int MATERIAL_MADE = 4;
const float kMaterialCount = 5.0;

/* The material a pixel has, from what outputMaterial wrote (to the
   nearest, so that a buffer of eight bits reads it back the same). */
int materialOf(float w) {
  return int(floor(kMaterialCount * w + 0.5));
}

#if 0

  /* Stereographic Normal Encoding ~ Singularity @ (0, 0, -1) */
  vec2 encodeNormal(vec3 n) {
    /* Avoid singularity via slight z-clamp. */
    n.z = max(-0.999999, n.z);
    const float scale = 1.7777;
    return 0.5 * (n.xy / (n.z + 1.0)) / scale + 0.5;
  }

  vec3 decodeNormal(vec2 n) {
    const float scale = 1.7777;
    vec3 nn = 2.0 * scale * vec3(n, 0.0) + vec3(-scale, -scale, 1.0);
    float g = 2.0 / dot(nn, nn);
    return vec3(g * nn.xy, g - 1.0);
  }

#else

  const float kPI = 3.1415926536;
  vec2 encodeNormal(vec3 n) {
    /* (straight along z there is no angle to take: atan(0, 0) is whatever
       the driver likes, and one answers with no number at all. A flat
       face of something that lies square to the world is exactly that.) */
    float angle = (abs(n.x) + abs(n.y) > 0.0) ? atan(n.y, n.x) : 0.0;
    return 0.5 * (vec2(angle / kPI, n.z) + 1.0);
  }

  vec3 decodeNormal(vec2 n) {
    vec2 ang = 2.0 * n - 1.0;
    vec2 scth = vec2(sin(ang.x * kPI), cos(ang.x * kPI));
    vec2 scphi = vec2(sqrt(max(0.0, 1.0 - ang.y * ang.y)), ang.y);
    return vec3(scth.y * scphi.x, scth.x * scphi.x, scphi.y);
  }

#endif

void outputAlbedo(vec3 a) {
  fragment_color0.xyz = asLight(a);
}

void outputAlpha(float alpha) {
  fragment_color0.w = asNumber(alpha);
}

void outputNormal(vec3 n) {
  /* (a normal that is none, the length of nothing made one, faces the eye's way) */
  fragment_color1.xy = encodeNormal((dot(n, n) > 0.0) ? n : vec3(0.0, 0.0, 1.0));
}

void outputRoughness(float roughness) {
  fragment_color1.z = asLight(roughness);
}

void outputMaterial(int m) {
  fragment_color1.w = float(m) / kMaterialCount;
}

/* (on one line: GLSL 1.20 has no carrying a line on to the next) */
#define EARLY_Z if (linearDepth > texture2D(depthBuffer, gl_FragCoord.xy * rcpFrame).x) discard;

#define PREPASS if (prepass == 1) { RETURN(vec4(linearDepth)); }
