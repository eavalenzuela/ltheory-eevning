#extension GL_EXT_gpu_shader4 : enable
/* (a fragment shader's texture lookups at a level it names, texture2DLod
   and textureCubeLod, are this extension's in GLSL 1.20: a driver that
   holds to the letter wants it asked for) */
#extension GL_ARB_shader_texture_lod : enable

#define V2T vec2
#define V3T vec3
#define V4T vec4
#define V4 vec4
#define V3 vec3
#define V2 vec2
#define tex2D texture2D

#ifdef GL_EXT_gpu_shader4
#define HIGHQ
#else
#define LOWQ
#endif

#if 1
  #define VERT_IN attribute
  #define VERT_OUT varying
  #define FRAG_IN varying
#else
  #define VERT_IN in
  #define VERT_OUT out
  #define FRAG_IN in
#endif

/* Numbers that are numbers.

   A division of nothing by nothing, a root of less than nothing, an angle
   asked of no direction: each leaves something that is no number, and
   whatever is worked out from it is none either. In a picture such a
   pixel is one black dot; but the bloom spreads what is bright over a
   patch of the screen, and spreads these with it, as black rectangles.

   min, max and clamp do not say what they do with such a thing, and the
   drivers differ: one's turn it into a number, another's let it through.
   A comparison does say: it is not more than, less than or equal to
   anything. So these are written as comparisons.

   asNumber: what is no number, or is past all size, is nothing.
   asLight: the same, for light and colour: and nothing below nothing,
   and nothing brighter than a picture's numbers can hold. */
float asNumber(float x) { return (x > -3.0e38 && x < 3.0e38) ? x : 0.0; }
vec2  asNumber(vec2 v)  { return vec2(asNumber(v.x), asNumber(v.y)); }
vec3  asNumber(vec3 v)  { return vec3(asNumber(v.x), asNumber(v.y), asNumber(v.z)); }
vec4  asNumber(vec4 v)  { return vec4(asNumber(v.x), asNumber(v.y), asNumber(v.z), asNumber(v.w)); }
float asLight(float x) { return (x >= 0.0) ? ((x <= 65000.0) ? x : 65000.0) : 0.0; }
vec3  asLight(vec3 v)  { return vec3(asLight(v.x), asLight(v.y), asLight(v.z)); }

float saturate(float t) { return clamp(t, 0.0, 1.0); }
vec2  saturate(vec2 f)  { return clamp(f, vec2(0.0), vec2(1.0)); }
vec3  saturate(vec3 f)  { return clamp(f, vec3(0.0), vec3(1.0)); }
vec4  saturate(vec4 f)  { return clamp(f, vec4(0.0), vec4(1.0)); }

const float farPlane = 1.0e6;
const float nearPlane = 0.05;

#if 1
  const float kGamma = 2.2;
  float toGamma(float t)  { return pow(t, 1.0 / kGamma); }
  vec2  toGamma(vec2 t)   { return pow(t, vec2(1.0 / kGamma)); }
  vec3  toGamma(vec3 t)   { return pow(t, vec3(1.0 / kGamma)); }
  vec4  toGamma(vec4 t)   { return pow(t, vec4(1.0 / kGamma)); }
  float toLinear(float t) { return pow(t, kGamma); }
  vec2  toLinear(vec2 t)  { return pow(t, vec2(kGamma)); }
  vec3  toLinear(vec3 t)  { return pow(t, vec3(kGamma)); }
  vec4  toLinear(vec4 t)  { return pow(t, vec4(kGamma)); }
#else
  vec3 toGamma(vec3 c)  { return c; }
  vec3 toLinear(vec3 c) { return c; }
  vec4 toGamma(vec4 c)  { return c; }
  vec4 toLinear(vec4 c) { return c; }
#endif
