/* The lie of the land of a world of lava, drawn once into a cube map
   for world_lava.jsl to light.

   Such a world is a thin black crust over fire. The low ground is open
   lava: seas of it, bright where it flows and dull where rafts of
   cooled crust drift on it. The crust between is broken into plates, at
   every size, and where it is thin (near a sea, or over a hot province)
   the cracks between the plates glow.

   Heights are to the scale of world_barren.jsl (0.5 the mean level,
   SCALE of the map's range one planet radius).

   Channels: x height, y heat (0 cold crust, 1 open flowing lava),
   z the tone of the crust (0 black basalt, 1 grey ash), w how much the
   ground is lit by lava nearby (0 to 1). */

#include frag.jsl
#include math.jsl
#include cube.jsl
#include worldnoise.jsl

uniform float seed;
uniform float seas;         /* how much of it is open lava, 0 to 1 */
uniform float fissures;     /* how far its crust is cracked through, 0 to 1 */

const float SCALE = 12.0;

void main() {
  vec3 p = GetCubePosition(uv, false);
  vec3 s = vec3(seed * 1.31, seed * 2.17, seed * 0.73);
  vec3 q = p + 0.20 * wn_drift(p * 1.6 + s);

  float low = -wn_fbm(q * 1.3 + s + 60.0, 6, 0.55);
  float edge = mix(0.32, -0.04, seas);
  float sea = smoothstep(edge, edge + 0.03, low);
  float shore = smoothstep(edge - 0.12, edge + 0.03, low);

  /* The crust: plates within plates, cracked along their edges. */
  vec3 w = q + 0.04 * wn_drift(q * 7.0 + s);
  vec3 big = wn_cells(w * 5.0 + s);
  vec3 mid = wn_cells(w * 13.0 + s + 9.0);
  vec3 small = wn_cells(w * 36.0 + s + 21.0);
  float crackBig = 1.0 - smoothstep(0.0, 0.06, big.y - big.x);
  float crackMid = 1.0 - smoothstep(0.0, 0.08, mid.y - mid.x);
  float crackSmall = 1.0 - smoothstep(0.0, 0.11, small.y - small.x);

  /* Where the crust is thin, the cracks are open to what is under it. */
  float province = smoothstep(-0.02, 0.22, wn_fbm(q * 2.3 + s + 13.0, 5, 0.55));
  float thin = saturate(0.15 * fissures + 0.95 * shore + 0.75 * province * fissures);
  float crack = max(crackBig, max(0.8 * crackMid * smoothstep(0.2, 0.6, thin), 0.6 * crackSmall * smoothstep(0.5, 0.9, thin)));
  float crackHeat = crack * thin;

  /* The seas: currents of bright lava, and rafts of crust on them. */
  vec3 f = q + 0.10 * wn_drift(q * 4.0 + s + 3.0);
  float current = wn_fbm(f * 9.0 + s, 5, 0.6) * 0.5 + 0.5;
  float raft = smoothstep(0.10, 0.22, mid.y - mid.x) * smoothstep(0.42, 0.62, mid.z + 0.3 * (current - 0.5));
  float seaHeat = sea * mix(0.55 + 0.45 * smoothstep(0.3, 0.75, current), 0.12, raft);

  float heat = max(seaHeat, crackHeat);
  float halo = saturate(0.9 * shore * (1.0 - sea) + 0.6 * thin * max(crackBig, crackMid) + 0.5 * sea * raft);

  float rolling = wn_fbm(q * 2.4 + s, 7, 0.55);
  float tone = saturate(0.35 + 0.8 * wn_fbm(q * 5.0 + s + 7.0, 5, 0.55) + 0.25 * (big.z - 0.5) + 0.2 * (mid.z - 0.5));
  float ground = (1.0 - sea) * (0.012 * rolling + 0.003 * (big.z - 0.5) + 0.0012 * (mid.z - 0.5)
    - 0.0030 * crackBig - 0.0012 * crackMid - 0.0005 * crackSmall + 0.004 * (1.0 - shore))
    - 0.004 * sea + 0.0008 * sea * raft;

  float height = 0.5 + SCALE * ground;
  RETURN(vec4(clamp(height, 0.0, 1.0), saturate(heat), tone, halo));
}
