#include frag.jsl
#include math.jsl

uniform samplerCube envMap;
uniform samplerCube irMap;

void main() {
  vec3 c = textureCube(envMap, vertpos).xyz;
  c = toLinear(c);
  outputAlbedo(c);
  outputAlpha(1.0);
  /* (the sky has no surface, but what is asked for is given: frag.jsl) */
  outputNormal(vec3(0.0, 0.0, 1.0));
  outputRoughness(0.0);
  outputMaterial(MATERIAL_NOSHADE);
}
