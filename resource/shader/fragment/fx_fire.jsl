/* A ball of fire: what is left for a moment where something has blown
   up. It swells fast and then slowly, billows, and cools from the
   outside in: white at its heart, then its own colour, then a dull red
   that thins away. fxAge runs from 0 to 1 over its life. (Additive, on a
   square from -1 to 1 in x and z.) */

#include frag.jsl
#include math.jsl
#include worldnoise.jsl

uniform vec3 fxColor;
uniform float fxFade;
uniform float fxAge;
uniform float fxSeed;

void main() {
  vec2 p = vertpos.xz;
  float r = length(p);
  float grow = mix(0.40, 1.0, pow(fxAge, 0.4));
  float q = r / grow;

  /* (the billows drift outward as it ages, and curdle) */
  float billow = wn_fbm(vec3(p * 2.6 / grow, fxSeed + 1.6 * fxAge), 4, 0.6)
    + 0.4 * wn_fbm(vec3(p * 9.0 / grow, fxSeed + 3.0 * fxAge), 3, 0.6);
  float body = 1.0 - smoothstep(0.30, 0.92, q + 0.55 * billow);
  float heat = body * (1.0 - fxAge) * (0.55 + 0.95 * saturate(1.0 - q)) + 0.6 * billow * body;

  vec3 c = mix(vec3(0.55, 0.07, 0.02), fxColor, smoothstep(0.12, 0.50, heat));
  c = mix(c, vec3(1.0, 0.95, 0.82), smoothstep(0.65, 1.05, heat));
  /* (several of these lie over one another in an explosion: each is
     kept dim enough that together they still have colour) */
  float a = 0.6 * body * smoothstep(0.0, 0.22, heat) * (1.0 - smoothstep(0.85, 1.0, r)) * fxFade;
  RETURN(vec4(c, 1.0) * a);
}
