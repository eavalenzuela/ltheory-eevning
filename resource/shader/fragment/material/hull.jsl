/* The skin of a hull built of tagged plates (Game/View/Hull): paint over
   metal, worn.

   Every plate carries a number in its v: the whole part says which paint
   it has (0 the hull's plating, 1 the plates that have been patched in,
   2 bare structure, 3 something lit from within, 4 trim, 5 the throat
   of an engine, lit the colour of its fire), and the
   fraction is the plate's own, so that no two plates are quite the same
   tone and their seams and rust do not line up. Its u is how open the
   place is to the sky (the occlusion baked into the mesh).

   On that: seams between the sheets a plate is made of; paint worn back
   to metal along every edge; rust that starts in the seams and the
   sheltered places and runs down from them; grime where the hull is
   closed in. How much of each is the hull's to say. Positions are the
   hull's own, so a hull looks the same at any size. */

#include frag.jsl
#include color.jsl
#include lighting.jsl
#include math.jsl
#include worldnoise.jsl

FRAG_IN vec3 normal;
FRAG_IN vec3 position;

uniform sampler2D depthBuffer;

uniform vec3 paintPlating;
uniform vec3 paintPatch;
uniform vec3 paintFrame;
uniform vec3 paintGlow;
uniform vec3 paintTrim;
uniform vec3 paintFire;
uniform float wear;         /* how far the paint is worn off, 0 to 1 */
uniform float rust;         /* how rusted, 0 to 1 */
uniform float sheets;       /* sheets of plating to a unit of the hull */
uniform float mottle;       /* how unlike one sheet is to the next, 0 to 1: a patchwork */
uniform float lights;       /* how many of its sheets have a lit port in them, 0 to 1 */
uniform float design;       /* the figure laid over its plating (Core/Data/Paints): 0 none */
uniform float designScale;  /* how many of the figure to half the hull's length */
uniform vec3 designMiddle;  /* the middle of the hull, and half its length: the figure is laid out from there */
uniform float designHalf;
uniform vec3 paintDesign;   /* the colour the figure is laid on in */
/* Cel shading, the second look (2, Cel V2; light/global.jsl): the paint is laid on flat, as it
   is in a drawing. No wear, rust or grime, and each plate nearly the
   same tone as the next; the seams kept, lighter. */
uniform float cel;

vec3 lin(vec3 c) {
  return pow(c, vec3(2.2));
}

/* Where a point is among the sheets of plating, across the face that
   'n' is the normal of: whole numbers are sheets. */
vec2 sheetAt(vec3 p, vec3 n, float offset) {
  vec3 a = abs(n);
  vec2 q = a.x > a.y && a.x > a.z ? p.zy : (a.y > a.z ? p.xz : p.xy);
  return q * sheets * vec2(1.0, 1.6) + offset;
}

/* Lines where one sheet of plating meets the next: 1 on a seam. */
float seams(vec2 q) {
  vec2 f = abs(fract(q) - 0.5);
  float d = 0.5 - max(f.x, f.y);
  return 1.0 - smoothstep(0.0, 0.035, d);
}

float sheetHash(vec2 cell, float salt) {
  return fract(sin(dot(cell, vec2(127.1, 311.7)) + salt * 17.3) * 43758.5453);
}

/* How much of a design's colour there is at a place on the hull (x),
   and how much of its second colour, which is what the paint marks
   things in (y): each 0 to 1. 'p' is the place from the hull's middle
   in halves of its length (x across it, y up, z along it toward the
   bow, 1 at the bow), so a figure is the same on a hull of any size.
   The figures are numbered as Core/Data/Paints numbers them. */
/* Where a place is across the band a hull wears "along its waist". On
   a flank (a surface that faces to one side, or fore or aft) that is
   its height from the hull's middle. On the back and the belly (a
   surface that faces up or down) it is how far it is from a line along
   the hull, out from its middle to either side: so the band is on the
   flanks of a deep hull and along the back of a flat one, and is seen
   from wherever the hull is looked at. */
float waistAt(vec3 p, vec3 n) {
  return abs(n.y) > 0.6 ? abs(p.x) - 0.15 : p.y;
}

vec2 designAt(vec3 p, vec3 n) {
  float k = designScale;
  float m = 0.0;
  float s = 0.0;
  if (design < 1.5) {
    /* a broad stripe down the middle, and a thin one either side of it */
    float x = abs(p.x) * k;
    float broad = 1.0 - smoothstep(0.30, 0.34, x);
    float thin = smoothstep(0.50, 0.54, x) * (1.0 - smoothstep(0.64, 0.68, x));
    m = max(broad, thin);
  } else if (design < 2.5) {
    /* hoops round the hull */
    float f = abs(fract(p.z * k) - 0.5);
    m = 1.0 - smoothstep(0.15, 0.18, f);
  } else if (design < 3.5) {
    /* chevrons: bands that meet on the middle line */
    float f = abs(fract((p.z + abs(p.x)) * k) - 0.5);
    m = 1.0 - smoothstep(0.15, 0.18, f);
  } else if (design < 4.5) {
    /* one side and the other */
    m = smoothstep(-0.008, 0.008, p.x);
  } else if (design < 5.5) {
    /* the bow, from so far forward of the middle */
    m = smoothstep(-0.012, 0.012, p.z - k);
  } else if (design < 6.5) {
    /* dazzle: a grid askew, each square cut corner to corner, and each half its own */
    vec2 q = vec2(p.x + 0.55 * p.z, p.z - 0.40 * p.x + 0.30 * p.y) * k;
    vec2 cell = floor(q);
    vec2 f = fract(q);
    float corner = step(f.x, f.y);
    m = step(0.5, sheetHash(cell + vec2(corner * 0.37, corner * 0.61), 9.0));
  } else if (design < 7.5) {
    /* tiger: stripes that waver */
    float w = p.z * k + 0.35 * sin(p.x * k * 2.3 + p.y * 3.1) + 0.7 * wn_noise(p * 3.0);
    float f = abs(fract(w) - 0.5) * 2.0;
    m = smoothstep(0.50, 0.58, f);
  } else if (design < 8.5) {
    /* chequers */
    vec2 c = floor(vec2(p.x + p.y * 0.5, p.z) * k);
    m = abs(mod(c.x + c.y, 2.0));
  } else if (design < 9.5) {
    /* woodland: blots of the design's colour, and of the second among them */
    float a = wn_noise(p * k);
    float b = wn_noise(p * k * 1.6 + vec3(11.3, 4.7, 7.9));
    m = smoothstep(0.10, 0.14, a);
    s = smoothstep(0.16, 0.20, b) * (1.0 - m);
  } else if (design < 10.5) {
    /* digital: small squares, clumped */
    vec3 c = floor(p * k);
    float clump = wn_noise(c / 5.0);
    float own = sheetHash(c.xz + vec2(c.y * 13.0, c.y * 7.0), 5.0);
    float v = clump + (own - 0.5) * 0.5;
    m = step(0.12, v);
    s = step(v, -0.14);
  } else if (design < 11.5) {
    /* splinter: long shards at angles, in three tones */
    vec2 q = vec2(p.x * 1.6 + 0.8 * p.z + 0.5 * p.y, p.z * 0.7 - 0.5 * p.x) * k;
    vec2 c = floor(q);
    vec2 f = fract(q);
    float corner = step(f.x, f.y);
    float h = sheetHash(c + vec2(corner * 0.37, corner * 0.61), 4.0);
    m = step(0.66, h);
    s = step(h, 0.30);
  } else if (design < 12.5) {
    /* polka dots: each other row stepped across */
    vec2 q = vec2(p.x + p.y * 0.6, p.z) * k;
    q.x += 0.5 * mod(floor(q.y), 2.0);
    vec2 f = fract(q) - vec2(0.5, 0.5);
    m = 1.0 - smoothstep(0.27, 0.31, length(f));
  } else if (design < 13.5) {
    /* candy stripe: bars slanting round the hull */
    float f = fract((p.z + p.x + 0.6 * p.y) * k);
    m = smoothstep(0.0, 0.04, f) * (1.0 - smoothstep(0.5, 0.54, f));
  } else if (design < 14.5) {
    /* harlequin: diamonds, in three colours */
    vec2 q = vec2(p.z + p.x + 0.5 * p.y, p.z - p.x - 0.5 * p.y) * k;
    vec2 c = floor(q);
    m = abs(mod(c.x + c.y, 2.0));
    s = (1.0 - m) * step(0.5, abs(mod(c.x, 2.0)));
  } else if (design < 15.5) {
    /* leopard: broken rings of the design's colour about spots of the second */
    vec2 q = vec2(p.x + p.y * 0.6, p.z) * k;
    vec2 c = floor(q);
    vec2 f = fract(q);
    vec2 at = vec2(0.3 + 0.4 * sheetHash(c, 1.0), 0.3 + 0.4 * sheetHash(c, 2.0));
    float d = length(f - at);
    float whole = step(-0.25, wn_noise(vec3(q.x * 3.0, q.y * 3.0, 1.7)));
    m = smoothstep(0.17, 0.20, d) * (1.0 - smoothstep(0.27, 0.30, d)) * whole;
    s = 1.0 - smoothstep(0.13, 0.16, d);
  } else if (design < 16.5) {
    /* flames, from the bow aft: tongues of the design's colour with a core of the second */
    float u = p.x * 7.0 + p.y * 5.0;
    float tongue = 0.5 + 0.5 * sin(u) * sin(u * 0.37 + 1.3);
    float edge = k - 0.9 * tongue * tongue + 0.12 * wn_noise(vec3(p.x * 6.0, p.y * 6.0, p.z * 2.0));
    m = smoothstep(edge - 0.01, edge + 0.01, p.z);
    s = smoothstep(edge + 0.21, edge + 0.23, p.z);
  } else if (design < 17.5) {
    /* zigzag: bands round the hull that go to and fro */
    float tooth = abs(fract((p.x + 0.6 * p.y) * k * 1.5) - 0.5);
    float f = fract(p.z * k + tooth);
    m = smoothstep(0.0, 0.05, f) * (1.0 - smoothstep(0.5, 0.55, f));
  } else if (design < 18.5) {
    /* battenburg: two rows of blocks along the waist, turn about in the design's colour and the second */
    float deep = 0.5 / k;
    float v = waistAt(p, n);
    float inside = 1.0 - smoothstep(deep, deep + 0.004, abs(v));
    float turn = abs(mod(floor(p.z * k) + step(0.0, v), 2.0));
    m = inside * turn;
    s = inside * (1.0 - turn);
  } else if (design < 19.5) {
    /* a band of small squares along the waist, three deep */
    float deep = 1.5 / k;
    float v = waistAt(p, n);
    float inside = 1.0 - smoothstep(deep, deep + 0.004, abs(v));
    vec2 c = floor(vec2(p.z, v + deep) * k);
    m = inside * abs(mod(c.x + c.y, 2.0));
  } else if (design < 20.5) {
    /* hazard bars: the after part in slanting bars, turn about */
    float aft = 1.0 - smoothstep(-k, -k + 0.01, p.z);
    float f = fract((p.z + p.x + 0.6 * p.y) * 6.0);
    float bar = step(0.5, f);
    m = aft * bar;
    s = aft * (1.0 - bar);
  } else if (design < 21.5) {
    /* waistband: a band along the waist, and a thin line of the second colour above it and below */
    float d = abs(waistAt(p, n));
    m = 1.0 - smoothstep(k, k + 0.004, d);
    s = smoothstep(k + 0.012, k + 0.016, d) * (1.0 - smoothstep(k + 0.026, k + 0.030, d));
  } else if (design < 22.5) {
    /* sash: a slanting band round the forward part, and a narrow one of the second colour behind it */
    float f = p.z + 0.9 * p.y - k;
    m = smoothstep(0.0, 0.01, f) * (1.0 - smoothstep(0.16, 0.17, f));
    s = smoothstep(-0.10, -0.09, f) * (1.0 - smoothstep(-0.05, -0.04, f));
  } else if (design < 23.5) {
    /* quarters: the bow to one side and the stern to the other */
    float side = smoothstep(-0.008, 0.008, p.x);
    float fore = smoothstep(-0.008, 0.008, p.z);
    m = side * fore + (1.0 - side) * (1.0 - fore);
  } else {
    /* tail bands: a broad band round the after part, and two narrow ones of the second colour ahead of it */
    float z = -p.z;
    m = smoothstep(k, k + 0.01, z) * (1.0 - smoothstep(k + 0.14, k + 0.15, z));
    float one = smoothstep(k - 0.07, k - 0.06, z) * (1.0 - smoothstep(k - 0.035, k - 0.025, z));
    float two = smoothstep(k - 0.14, k - 0.13, z) * (1.0 - smoothstep(k - 0.105, k - 0.095, z));
    s = max(one, two);
  }
  return vec2(m, s);
}

void main() {
  PREPASS
  EARLY_Z

  float tag = uv.y + 0.001;
  float part = floor(tag);
  float own = fract(tag);
  float open = uv.x;
  vec3 p = vertpos;
  vec3 n = normalize(vertnormal);

  if ((part > 2.5 && part < 3.5) || part > 4.5) {
    /* Lit from within: a row of ports, or an engine's throat. */
    outputAlbedo(lin(part > 4.5 ? paintFire : paintGlow) * (2.2 + 1.2 * wn_noise(p * 9.0)));
    outputAlpha(1.0);
    outputNormal(normalize(normal));
    outputMaterial(MATERIAL_NOSHADE);
    outputRoughness(0.0);
    return;
  }

  bool bare = part > 1.5 && part < 2.5;
  vec3 paint = part < 0.5 ? paintPlating : (part < 1.5 ? paintPatch : (bare ? paintFrame : paintTrim));
  /* (a design is laid over the plating and the plates patched in, and over nothing else) */
  if (design > 0.5 && part < 1.5) {
    vec2 laid = designAt((p - designMiddle) / max(designHalf, 0.001), n);
    paint = mix(paint, paintDesign, laid.x);
    paint = mix(paint, paintTrim, laid.y);
  }
  /* (each plate a little lighter or darker, and off in hue, than the next) */
  float grain = 1.0 - step(1.5, cel);
  paint *= mix(0.94 + 0.12 * own, 0.68 + 0.58 * own, grain);
  paint = mix(paint, vec3(dot(paint, vec3(0.33))), (0.25 * sin(own * 40.0) + 0.1) * grain);

  /* The edges of a plate, where its bevel turns: the smoothed normal is
     shorter there. */
  float edge = 1.0 - exp(-900.0 * length(normal - normalize(normal)));
  vec2 sheet = sheetAt(p, n, own * 13.0);
  float seam = bare ? 0.0 : seams(sheet);
  if (!bare && mottle > 0.0) {
    /* A patchwork: each sheet its own tone, and some of them the other
       paint altogether. */
    vec2 cell = floor(sheet);
    paint *= 1.0 + mottle * 0.5 * (sheetHash(cell, 1.0) - 0.5);
    if (part < 1.5 && sheetHash(cell, 2.0) < 0.30 * mottle)
      paint = mix(paint, (part < 0.5 ? paintPatch : paintPlating) * (0.75 + 0.4 * own), 0.7);
    seam *= 1.0 - 0.6 * mottle;
  }
  if (!bare && lights > 0.0 && part < 1.5) {
    /* A lit port in some of the sheets: a pinpoint, which is what says
       how big the hull is. (Not on its back or its keel.) */
    vec2 fine = sheet * 3.0;
    vec2 cell = floor(fine);
    vec2 at = fract(fine) - 0.5;
    if (sheetHash(cell, 3.0) < 0.22 * lights && abs(n.y) < 0.75 && max(abs(at.x) * 1.6, abs(at.y) * 3.2) < 0.34) {
      outputAlbedo(lin(paintGlow) * (1.6 + 1.4 * sheetHash(cell, 4.0)));
      outputAlpha(1.0);
      outputNormal(normalize(normal));
      outputMaterial(MATERIAL_NOSHADE);
      outputRoughness(0.0);
      return;
    }
  }

  float blotch = wn_fbm(p * 2.2 + own * 31.0, 5, 0.55);
  float fine = wn_fbm(p * 19.0 + own * 7.0, 4, 0.6);
  /* (streaks: the same noise drawn out downward) */
  float streak = wn_fbm(vec3(p.x * 9.0, p.y * 1.1, p.z * 9.0) + own * 17.0, 4, 0.6);

  /* Paint gone to metal: along edges, and scuffed off in patches. */
  float worn = grain * saturate(wear * (1.6 * edge + smoothstep(0.10, 0.45, blotch + 0.5 * fine) * 0.7));
  /* Rust: out of the seams and the sheltered places, and down. */
  float sheltered = 1.0 - smoothstep(0.25, 0.75, open);
  float rusted = rust * saturate(1.4 * seam * (0.4 + streak) + 0.9 * sheltered + smoothstep(0.02, 0.30, streak + 0.5 * blotch) * 0.8
    + 0.5 * worn);
  rusted = grain * saturate(rusted * (0.7 + 0.6 * fine + 0.3));

  vec3 metal = vec3(0.30, 0.31, 0.33) * (0.85 + 0.3 * fine);
  vec3 oxide = mix(vec3(0.20, 0.08, 0.04), vec3(0.36, 0.17, 0.07), saturate(0.5 + fine + streak));
  vec3 c = bare ? mix(paint, metal, 0.22) : mix(paint, metal, worn);
  c = mix(c, oxide, bare ? 0.6 * rusted : rusted);
  c *= 1.0 - mix(0.30, 0.55, grain) * seam;
  /* grime, where the hull is closed in */
  float shut = 1.0 - smoothstep(0.05, 0.65, open);
  c *= 1.0 - 0.5 * shut * grain;
  c *= mix(1.0, 0.9 + 0.2 * fine, grain);

  float rough = mix(0.16, 0.05, worn);
  rough = mix(rough, 0.2, rusted);
  if (bare) rough = mix(0.07, 0.2, rusted);

  /* (flat paint is lighter than worn paint on the whole: brought back to
     where it was, so that a pale paint is not white) */
  outputAlbedo(lin(c) * mix(mix(0.75, 0.30, grain), 1.0, smoothstep(0.0, 0.75, open)) * mix(3.6, 4.6, grain));
  outputAlpha(1.0);
  outputNormal(normalize(normal));
  outputMaterial(MATERIAL_COOKT);
  outputRoughness(rough);
}
