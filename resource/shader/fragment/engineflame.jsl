/* An engine's fire (Game/View/Effects' Thrust): a volume of the shape of
   its opening, drawn in as it goes aft (its mesh is rings of the
   opening's outline; uv.y is how far aft, 0 at the mouth, 1 at the
   end). White-hot at the mouth as hard as it is driven, its people's
   colour about that, and gone by the end; a shimmer running down it. Seen
   through, its near and far sides add up, so it is brightest down its
   middle and soft at its edges, a body and not a sheet (the owner,
   2026-11-28). (Additive, both faces.) */

#include frag.jsl
#include math.jsl

uniform vec3 fireColor;
uniform float heat;
uniform float time;

void main() {
  float y = clamp(uv.y, 0.0, 1.0);
  float along = pow(1.0 - y, 1.6) * (1.0 - smoothstep(0.85, 1.0, y));
  float shimmer = 0.85 + 0.15 * sin(y * 24.0 - time * 21.0 + uv.x * 6.2832);
  float hot = exp(-y * 5.0) * heat;
  float a = 0.42 * along * shimmer * (0.3 + 0.7 * heat);
  RETURN(vec4(mix(fireColor, vec3(1.0, 0.97, 0.9), saturate(hot)), 1.0) * a);
}
