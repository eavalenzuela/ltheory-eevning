#include frag.jsl

uniform sampler2D texture;
uniform float alpha;

// (a picture's own see-through parts stay see-through: the inventory's
// icons are drawn on nothing; a portrait or the splash is opaque)
void main() {
  vec4 c = texture2DLod(texture, uv, 0.0);
  RETURN(vec4(c.xyz, c.w * alpha));
}
