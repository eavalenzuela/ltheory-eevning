/* An engine's fire: a flame as wide as the mouth it leaves (uv.y of 0),
   white-hot down its middle there, narrowing and dying away behind,
   with a shimmer running down it ('fxAge' is the time). (Additive.) */

#include frag.jsl
#include math.jsl

uniform vec3 fxColor;
uniform float fxFade;
uniform float fxAge;

void main() {
  float x = abs(2.0 * uv.x - 1.0);
  float y = uv.y;

  /* (across it, in widths of the flame where it is) */
  float q = x / mix(0.85, 0.30, sqrt(y));
  float along = exp(-y * 2.8) * (1.0 - smoothstep(0.60, 1.0, y));
  float body = exp(-q * q * 2.6) * along;
  float core = exp(-q * q * 9.0) * exp(-y * 6.0);
  float shimmer = 0.88 + 0.12 * sin(y * 30.0 - fxAge * 26.0);
  float mouth = smoothstep(0.0, 0.03, y);

  float a = (0.9 * body + 1.2 * core) * shimmer * mouth * fxFade;
  RETURN(vec4(mix(fxColor, vec3(1.0), saturate(1.2 * core)), 1.0) * a);
}
