#include frag.jsl

#define SMAA_ONLY_COMPILE_PS
#include smaa.jsl

uniform sampler2D texture;
uniform sampler2D blendWeights;
/* above a half: the blending as the method's authors wrote it, in place
   of this program's own (RenderPass_SMAASet) */
uniform float plainBlend;

FRAG_IN vec4 offset[2];

void main() {
  vec4 c;
  if (plainBlend > 0.5)
    c = SMAANeighborhoodBlendingPlainPS(uv, texture, blendWeights);
  else
    c = SMAANeighborhoodBlendingPS(uv, offset, texture, blendWeights);
  RETURN(c);
}
