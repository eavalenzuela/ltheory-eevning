/* A living world: sea and land from the heights in its cube map, dressed
   by climate, lit with its relief, under cloud that casts shadow, inside
   an atmosphere.

   The parts, in the order they are applied:
     ground    sea where the height is under the sea level, land above;
               the land's colour from how warm it is (latitude and
               altitude) and how wet, rock on the steeps, snow and ice
     relief    the surface normal tilted by the slope of the heights
     light     the star on that normal, a glint on the water
     cloud     and its shadow, thrown along the light
     air       scattering between the eye and the ground (scattering.jsl;
               the glow beyond the limb is the shell drawn round this,
               atmosphere.jsl)

   Colours are in linear light throughout. */

#include frag.jsl
#include math.jsl
#include color.jsl
#include noise.jsl
#include lighting.jsl
#include scattering.jsl
#include worldnoise.jsl
#include globemap.jsl

uniform float seaLevel;
uniform float cloudCover;
uniform float iceLine;
uniform float cityLights;

/* How the ground is coloured, as it should look on a screen (turned to
   linear light where used). */
const vec3 kDeep = vec3(0.012, 0.045, 0.14);
const vec3 kShallow = vec3(0.05, 0.22, 0.32);
const vec3 kSand = vec3(0.62, 0.55, 0.38);
const vec3 kDesert = vec3(0.60, 0.46, 0.28);
const vec3 kGrass = vec3(0.26, 0.36, 0.13);
const vec3 kForest = vec3(0.07, 0.19, 0.06);
const vec3 kTundra = vec3(0.34, 0.33, 0.25);
const vec3 kRock = vec3(0.33, 0.29, 0.25);
const vec3 kSnow = vec3(0.90, 0.92, 0.95);

float cloudAt(vec3 dir) {
  float c = textureCube(planetMap, dir).z;
  /* (the map's cloud values crowd round a half: the threshold runs from
     well above that for a clear sky to well below it for an overcast one) */
  float t = mix(0.70, 0.30, cloudCover);
  /* (finer than the map holds: broken edges and streaks, so that cloud
     seen close is not a smear) */
  c += 0.07 * wn_fbm(dir * 34.0, 3, 0.55) + 0.03 * wn_noise(dir * 140.0);
  float d = smoothstep(t - 0.04, t + 0.11, c);
  return d * d * (3.0 - 2.0 * d);
}

void main() {
  PREPASS

  vec3 dir = normalize(vertpos);
  vec3 sphere = normalize(normal);
  vec3 L = normalize(starPos - position);
  vec3 V = normalize(position - eye);
  /* (the way to the star in the globe's own frame, for looking things
     up in its map) */
  vec3 Lb = toBody(L);

  vec4 map = textureCube(planetMap, dir);
  float h = map.x;
  float land = smoothstep(seaLevel - 0.004, seaLevel + 0.004, h);
  float alt = max(0.0, (h - seaLevel) / (1.0 - seaLevel));
  float lat = abs(dir.y);

  /* Relief: the slope of the heights, tilting the normal. */
  vec3 east, north;
  groundFrame(dir, east, north);
  vec2 slope = groundSlope(dir, east, north, 0.0018);
  vec3 N = toWorld(normalize(dir - relief * land * (slope.x * east + slope.y * north)));
  float steep = saturate(length(slope) * 0.9);

  /* Ground. */
  float warm = 1.0 - pow(lat, 1.6) * 1.15 - 0.9 * alt;
  float wet = map.y;
  float patchy = wn_fbm(dir * 55.0, 3, 0.5);
  vec3 green = mix(kGrass, kForest, smoothstep(0.36, 0.62, wet + 0.12 * patchy));
  vec3 ground = mix(kDesert, green, smoothstep(0.12, 0.30, wet + 0.08 * patchy));
  ground *= 0.90 + 0.22 * patchy;
  ground = mix(kTundra, ground, smoothstep(0.12, 0.38, warm));
  ground = mix(ground, kRock, saturate(smoothstep(0.30, 0.55, alt) + steep * smoothstep(0.08, 0.25, alt)));
  ground = mix(kSand, ground, smoothstep(0.0, 0.012, alt));
  float snow = smoothstep(0.02, 0.10, (alt - 0.42) + (0.30 - warm) * 0.9) * (1.0 - 0.6 * steep);
  ground = mix(ground, kSnow, saturate(snow));

  vec3 sea = mix(kDeep, kShallow, smoothstep(seaLevel - 0.10, seaLevel, h));
  float ice = smoothstep(iceLine, iceLine + 0.04, lat + 0.06 * (map.z - 0.5));
  sea = mix(sea, kSnow * 0.92, ice);

  vec3 albedo = lin(mix(sea, ground, land));

  /* Light. */
  float ndl = dot(N, L);
  float sphereLit = saturate(dot(sphere, L) * 4.0 + 0.3);
  float lit = saturate(ndl) * sphereLit;
  /* Mountains throw shadows when the star is low (softened: the air
     fills them). */
  lit *= mix(1.0, groundShadow(dir, max(h, seaLevel), Lb, 0.03), 0.7);

  /* Cloud, and where its shadow falls. */
  float cloud = cloudAt(dir);
  float shadow = cloudAt(normalize(dir + 0.012 * Lb));
  lit *= 1.0 - 0.6 * shadow * (1.0 - cloud);

  vec3 sun = mix(starColor, vec3(1.0), whiteLight);
  /* Toward the terminator the light has come a long way through the
     air, and is red. */
  sun *= mix(vec3(1.0, 0.36, 0.14), vec3(1.0), smoothstep(-0.05, 0.28, dot(sphere, L)));
  vec3 color = albedo * sun * (lit + 0.006);

  /* The sun on the water. */
  float water = (1.0 - land) * (1.0 - ice) * (1.0 - cloud) * (1.0 - cloud);
  float mirror = max(0.0, dot(reflect(V, sphere), L));
  /* (a rough sea: a broad soft sheen, not the star's image) */
  float glint = 0.30 * pow(mirror, 90.0) + 0.06 * pow(mirror, 14.0);
  color += water * sun * glint * sphereLit * (1.0 - 0.8 * shadow);

  /* Cloud tops: bright, and brighter on the side facing the light. */
  float thick = saturate(cloud + 2.0 * (cloud - shadow));
  vec3 cloudColor = lin(vec3(0.93, 0.94, 0.96)) * sun * (saturate(dot(sphere, L)) * sphereLit * (0.75 + 0.25 * thick) + 0.006);
  color = mix(color, cloudColor, cloud * 0.96);

  /* Cities, on the night side, where people would live: low, green or
     grassy, near a coast. */
  float night = 1.0 - saturate(dot(sphere, L) * 6.0 + 0.6);
  float settled = land * (1.0 - snow) * smoothstep(0.20, 0.45, wet) * (1.0 - smoothstep(0.01, 0.14, alt)) * smoothstep(0.1, 0.4, warm);
  /* Towns gather into regions, and within a region into a few bright
     cities and a scatter of small ones; most of the land is dark. */
  float region = smoothstep(0.62, 0.86, snoise(dir * 9.0 + 3.1)) + 0.5 * smoothstep(0.70, 0.9, snoise(dir * 23.0 + 11.7));
  float cities = pow(snoise(dir * 160.0), 9.0) * 6.0 + pow(noise(floor(dir * 900.0)), 40.0) * 2.0;
  color += cityLights * night * settled * saturate(region) * cities * lin(vec3(1.0, 0.72, 0.38)) * (1.0 - cloud * 0.85);

  /* Air. */
  vec4 atmo = getScattering(origin, eye, V, length(position - eye));
  color += atmo.xyz;

  outputAlbedo(color);
  outputAlpha(1.0);
  outputNormal(N);
  outputMaterial(MATERIAL_NOSHADE);
  outputRoughness(0.0);
}
