function Texture Get ()
  # A random screenshot from the folder the launcher's F1 key saves to, or the
  # splash image if there aren't any yet
  var dir "cache/screenshot/"
  var path "resource/texture/splash.png"
  if dir.IsDirectory
    var contents dir.ListDir
    if contents.Size > 0
      path = dir + (contents.Get (Int_Random contents.Size))

  Texture_LoadFrom
    Location_File path
