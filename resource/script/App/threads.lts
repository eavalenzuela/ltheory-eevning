type MyJob
  function Int Main ()
    var sum 0
    for i 0 i < 10000 (++ i)
      sum += i
    sum

type Threads
  function Void Initialize ()
    var thread (Thread_Create MyJob "Main")
    while (! thread.IsFinished)
      0
    @ "Result: " (cast Int thread.GetResult)

function Threads Main ()
  Threads
