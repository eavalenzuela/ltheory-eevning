# Scripted check of the core gameplay loop, run with `bin/launch test_gameplay`:
# mine a rock, dock (Task_Dock), move ore to the station locker, sell it into
# the station's ore bids, buy a weapon, fit and unplug it, undock, and dock a
# spare ship with the Dock binding. Prints each step; no input needed.

type App
  Object universe
  Object system
  Object station
  Object rock
  Object ship
  Player player
  Camera camera
  Int frame 0
  Int phase 0
  Float dockTime 0.0

  function Void Create (Widget self)
    camera = Camera_Create
    camera.Push
    universe = (Object_Universe 39 0)
    system = universe
    while (! system.IsSystem)
      system = system.GetInteriorObjects.Get

    for it system.GetInteriorObjects it.HasMore it.Advance
      var o it.Get
      if o.HasComponentDockable && o.HasComponentMarket && station.IsNull
        station = o
      if o.HasComponentMineable && rock.IsNull
        rock = o
    @ "station: " station.GetName "  rock radius: " rock.GetRadius " pos-center: " (Length rock.GetPos - rock.GetCenter)

    var shipType (Item_ShipType 20000 55 1 1 1 1 1 1)
    ship = shipType.Instantiate
    ship.Plug (Item_TransferUnitType 1 1 1 1 1 1)
    ship.SetPos rock.GetPos + (rock.GetRadius + ship.GetRadius + 20.0) * (Vec3 1 0 0)
    system.AddInterior ship
    player = Player_Human
    player.AddCredits 10000
    player.AddAsset ship
    player.Pilot ship
    camera.SetTarget ship
    @ "ship capacity: " ship.GetCapacity

  function List CreateChildren (Widget self)
    var l List
    var passes Vector<Reference<RenderPassT>>
    passes.Append (RenderPass_Clear (Vec4 0.0))
    passes.Append (RenderPass_Camera camera)
    l += (Widget_Rendered passes)
    l

  function Void FireMiners ()
    for it ship.GetSockets it.HasMore it.Advance
      var module it.Get
      if module.IsNotNull
        var mining false
        for c module.GetChildren c.HasMore c.Advance
          if c.Get.IsTransferUnit
            mining = true
        if mining
          module.Broadcast MessageFire
          module.Broadcast (MessageTargetPosition rock.GetCenter)

  function Int CargoCount ()
    var n 0
    for it ship.GetCargo it.HasMore it.Advance
      n += (cast Int it.GetQuantity)
    n

  function Void PreUpdate (Widget self)
    var dt 0.05
    frame += 1

    if phase == 0
      if (Mod frame 20) == 0
        var rng (RNG_MTG frame)
        ship.SetPos rock.GetCenter + (rock.GetRadius + ship.GetRadius + 10.0) * rng.Direction
      this.FireMiners
      if (Mod frame 40) == 0
        @ "mining: frame " frame " cargo items " this.CargoCount
      if frame >= 600
        @ "MINED " this.CargoCount " items"
        ship.PushTask (Task_Dock station)
        phase = 1

    if phase == 1
      dockTime += dt
      if ship.GetContainer == station
        @ "DOCKED after " dockTime " s"
        var locker (station.GetStorageLocker player)
        var moved (ship.TransferCargo locker)
        @ "TRANSFERRED " moved " items; ship cargo now " this.CargoCount
        phase = 2
      if dockTime > 300.0
        @ "DOCK TIMEOUT"
        phase = 2

    if phase == 2
      var locker (station.GetStorageLocker player)
      @ "credits before selling: " player.GetCredits
      # Collect first: selling escrows items out of the locker mid-iteration
      var ores List
      for it locker.GetCargo it.HasMore it.Advance
        ores += it.GetItem
      for oreIndex 0 oreIndex < ores.Size oreIndex.++
        var ore (cast Item (ores.Get oreIndex))
        var count (locker.GetItemCount ore)
        var data (station.GetMarketData ore)
        var bids data.bids
        var best 0
        for i 0 i < bids.Size i.++
          var order (bids.Get i)
          best = (Max best (cast Int order.price))
        @ "  " ore.GetName " x" count " best bid " best " (" bids.Size " bids)"
        if best > 0
          station.AddMarketSellOrder player ore count best
      @ "credits after placing sell orders: " player.GetCredits

      # Buy the cheapest weapon on sale
      var cheapest Item
      var cheapestPrice 1000000000
      for it station.GetMarketListings it.HasMore it.Advance
        var listing it.Get
        if listing.item.IsWeaponType
          var asks listing.asks
          for i 0 i < asks.Size i.++
            var order (asks.Get i)
            if (cast Int order.price) < cheapestPrice
              cheapestPrice = (cast Int order.price)
              cheapest = listing.item
      var shown 0
      for it station.GetMarketListings it.HasMore it.Advance
        var listing it.Get
        if listing.item.IsWeaponType && shown < 6
          @ "  weapon " listing.item.GetName " value " listing.item.GetValue
          shown += 1
      @ "cheapest weapon " cheapest.GetName " at " cheapestPrice " (item value " cheapest.GetValue ")"
      station.AddMarketBuyOrder player cheapest 1 cheapestPrice
      @ "bought: locker has " (locker.GetItemCount cheapest) "; credits " player.GetCredits

      # Fit it, then remove it again
      @ "plug returned " (ship.Plug cheapest)
      var fitted Object
      for it ship.GetSockets it.HasMore it.Advance
        var module it.Get
        if module.IsNotNull
          for c module.GetChildren c.HasMore c.Advance
            if c.Get.IsWeapon
              fitted = module
      var removed (ship.Unplug fitted)
      @ "unplugged item: " removed.GetName " same as bought: " (removed == cheapest)

      @ "UNDOCK returned " ship.Undock " container is system: " (ship.GetContainer == system)
      var spareType (Item_ShipType 20000 7 1 1 1 1 1 1)
      var spare spareType.Instantiate
      system.AddInterior spare
      @ "DOCK binding returned " (station.Dock spare) " spare inside station: " (spare.GetContainer == station)
      dockTime = 0.0
      phase = 3

    if phase == 3
      dockTime += dt
      if dockTime > 3.0
        @ "credits after market updates: " player.GetCredits
        phase = 4

    system.Update dt

function Data Main ()
  widget:Create
    Stack
      Custom Widget App
