type MessageOpenMarket
type MessageOpenFitting
type MessageDeposit
type MessageUndock

# Station services, shown while the player is docked at a station with a market
type StationPanel
  Player player
  Object station Object

  function Object DockedAt ()
    # Null-safe: apps like 'hud' show the HUD for a player whose ship may not
    # be placed in the world
    var result Object
    var ship player.GetPiloting
    if ship.IsNotNull
      var container ship.GetContainer
      if container.IsNotNull
        if container.HasComponentDockable && container.HasComponentMarket
          result = container
    result

  function List CreateChildren (Widget self)
    var l List
    station = this.DockedAt
    if station.IsNotNull
      l +=
        Components:AlignCenter
          Widgets:Text Fonts:Subheading "DOCKED AT " + station.GetName.UpperCase 16.0 1.0
      l +=
        Components:Expand
          Widgets:ListH4 8
            Components:Expand
              Components:GreedyX
                Button:Create MessageOpenMarket "MARKET" 14.0
            Components:Expand
              Components:GreedyX
                Button:Create MessageOpenFitting "FITTING" 14.0
            Components:Expand
              Components:GreedyX
                Button:Create MessageDeposit "DEPOSIT CARGO" 14.0
            Components:Expand
              Components:GreedyX
                Button:Create MessageUndock "UNDOCK" 14.0
    l

  function Void PreDraw (Widget self)
    if station.IsNotNull
      DrawPanel self.pos self.size 0.05 0.8 1 8

  function Void PreUpdate (Widget self)
    # Show or hide as the player docks and undocks
    if this.DockedAt != station
      self.Rebuild

  function Void Receive (Widget self Data data)
    var ship player.GetPiloting
    switch
      (data.IsType "MessageOpenMarket")
        self.SendUp
          Messages:MessageAddWidget
            Widget/Object/Market:Create player station

      (data.IsType "MessageOpenFitting")
        self.SendUp
          Messages:MessageAddWidget
            Fitting:Create player station

      (data.IsType "MessageDeposit")
        var moved (ship.TransferCargo (station.GetStorageLocker player))
        switch
          moved > 0
            player.AddLog "Moved " + moved + " items to your hangar at " + station.GetName
          otherwise
            player.AddLog "Nothing to deposit"
        Sound_Play "ui/elementselect.wav" 0.2

      (data.IsType "MessageUndock")
        ship.Undock
        player.AddLog "Undocked from " + station.GetName
        self.Rebuild

function Widget Create (Player player)
  Components:Padding (Vec2 16 8) (Vec2 16 8)
    ListV 8
      Custom Widget
        StationPanel player
